{
  "version": 8,
  "name": "MageRide Dark",
  "glyphs": "https://tiles.mageride.lk/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "vector",
      "url": "pmtiles://__PMTILES_URL__",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#121316" } },
    { "id": "earth", "type": "fill", "source": "basemap", "source-layer": "earth",
      "paint": { "fill-color": "#1A1C1E" } },
    { "id": "landuse", "type": "fill", "source": "basemap", "source-layer": "landuse",
      "paint": { "fill-color": "#2A2D31", "fill-opacity": 0.6 } },
    { "id": "water", "type": "fill", "source": "basemap", "source-layer": "water",
      "paint": { "fill-color": "#00497D" } },
    { "id": "roads-casing", "type": "line", "source": "basemap", "source-layer": "roads",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#121316",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.4, 14, 6, 18, 22]
      } },
    { "id": "roads", "type": "line", "source": "basemap", "source-layer": "roads",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#43474E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 14, 4, 18, 18]
      } },
    { "id": "buildings", "type": "fill", "source": "basemap", "source-layer": "buildings",
      "minzoom": 14,
      "paint": { "fill-color": "#2A2D31", "fill-outline-color": "#43474E" } },
    { "id": "boundaries", "type": "line", "source": "basemap", "source-layer": "boundaries",
      "paint": { "line-color": "#8D9199", "line-dasharray": [3, 2], "line-width": 1 } },
    { "id": "places", "type": "symbol", "source": "basemap", "source-layer": "places",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Inter Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 11, 14, 14]
      },
      "paint": { "text-color": "#C3C7CF", "text-halo-color": "#121316", "text-halo-width": 1.2 } }
  ]
}
