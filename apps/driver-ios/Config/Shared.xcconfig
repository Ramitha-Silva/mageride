// Settings both build configurations share. The per-configuration values are in Debug/Release.
//
// This is the iOS counterpart of `apps/driver-android/build.gradle.kts` — the reasoning for each
// value lives here, and `DriverApp/DI/DriverEnvironment.swift` is the only code allowed to read one.

PRODUCT_NAME = DriverApp
PRODUCT_BUNDLE_IDENTIFIER = lk.mageride.driver
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 0.1.0

// **iOS 16.0**, and the floor is a decision this component had to make: URD §5.5 NFR-22 pins the
// Android minimum (8.0 / API 26) and neither URD, ADD nor D2' states an iOS deployment target — the
// C000 planner recorded exactly that gap. 16.0 is the answer for two reasons that agree:
//
//   * `NavigationStack` is iOS 16, and D2' §C names it as the scaffolding primitive. Below 16 the
//     whole navigation row of Section C would have to be rewritten around the deprecated
//     `NavigationView`.
//   * NFR-22's *intent* is reach on budget hardware. iOS 16 runs on the iPhone 8 and the SE 2 —
//     2017 hardware, the same year as the Android 8.0 floor. iOS 17 drops both.
//
// Every dependency clears it: MapLibre iOS needs 12, CocoaMQTT 12, Firebase 13, App Attest 14.
IPHONEOS_DEPLOYMENT_TARGET = 16.0
TARGETED_DEVICE_FAMILY = 1

SWIFT_VERSION = 5.0
ENABLE_USER_SCRIPT_SANDBOXING = YES

// `minimal`, and deliberately not `complete`. This code was written on a host that cannot compile
// it (root CLAUDE.md), so raising the concurrency checking to a level that rejects code no one has
// been able to build would put an unknown number of diagnostics between C086 and its first green
// build. It belongs to C103, after the first `xcodebuild` on a Mac is green — every actor
// annotation the app needs is already written, so the step should be small.
SWIFT_STRICT_CONCURRENCY = minimal

// Portrait only — see `UISupportedInterfaceOrientations` in `DriverApp/Info.plist`. It lives there
// rather than as an `INFOPLIST_KEY_*` build setting because those are only read when
// `GENERATE_INFOPLIST_FILE` is YES, and this target ships a real plist.

// Sinhala first (AL-26), then Tamil, then English. `DEVELOPMENT_LANGUAGE` stays `en` because it is
// the *fallback* — the language iOS resolves a key to when a translation is missing — and the three
// `.lproj` directories are what the driver actually gets. The order above is the onboarding
// screen's, not the fallback order.
DEVELOPMENT_LANGUAGE = en

// The base-plate for the Info.plist. `GENERATE_INFOPLIST_FILE` is deliberately OFF: this target's
// plist carries a `MageRide` dictionary, four background modes and three purpose strings, none of
// which a generated plist can express.
INFOPLIST_FILE = DriverApp/Info.plist
CODE_SIGN_ENTITLEMENTS = DriverApp/DriverApp.entitlements

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// CI archives with `CODE_SIGNING_ALLOWED=NO`, and a developer signs with their own team. Neither is
// pinned here — a `DEVELOPMENT_TEAM` in a tracked file is the setting every contributor has to
// un-set locally.
CODE_SIGN_STYLE = Automatic
