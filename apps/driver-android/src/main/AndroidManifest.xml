<?xml version="1.0" encoding="utf-8"?>
<!--
  MageRide Driver — application shell (C067).

  PERMISSIONS ARE A SCREEN'S JUSTIFICATION, NOT A SHELL'S CONVENIENCE. Every one below exists
  because something in this component needs it, and SCR-DA-007 (C068) is where the driver is asked
  for the runtime ones with a rationale. Nothing is declared "in case a later screen wants it".

  `usesCleartextTraffic` is NOT here — it belongs to the debug variant alone and lives in
  src/debug/AndroidManifest.xml. Production is HTTPS at HAProxy (ADD §12.2).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- D6' §3 / D5' §5 — the position plane. BACKGROUND_LOCATION is what keeps the stream alive
         with the app behind the lock screen, which is where a mounted handset spends a ride. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- The PARTIAL_WAKE_LOCK the position service holds so Doze cannot stretch the D5' §5.2
         cadence into minutes. See PositionForegroundService. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- E-01's ride offers live 15 seconds; a driver who cannot be notified cannot be dispatched. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- SCR-DA-007's battery-optimisation intent. Declaring it lets the screen open the system
         dialog; the app never assumes the exemption was granted. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- SCR-DA-007's "Display over apps" row (C068). A special app access, not a runtime grant:
         `Settings.canDrawOverlays` answers false until the driver turns it on in Settings, and
         `ACTION_MANAGE_OVERLAY_PERMISSION` cannot be opened for an app that has not declared it.
         It is what lets an E-01 offer take over while the driver is in another app; the offer
         itself is C070's. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- SCR-DA-005's document scanner (AL-43, C069). Every onboarding image — the two licence
         sides and the four vehicle documents — is captured through it, and a denied grant is a
         state the screen draws ("Allow camera"), never a crash. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- GPS is not `required`: a handset without it can still hold an account, see its wallet and
         complete onboarding. What it cannot do is go online, and the dashboard says so.
         The camera is `required="false"` for the same reason and one more: the scanner falls back
         to the gallery picker, so a handset with a broken camera can still be onboarded. -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".DriverApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.MageRideDriver">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- notification-svc's deep links (`DeepLinks` in its EventHandlers.cs; D6' I-23.3):
                 mageride://ride/{id}, //package/{id}, //wallet, //documents. `PushRouter` resolves
                 the URI against the known route table rather than navigating to it directly. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mageride" />
            </intent-filter>
        </activity>

        <!-- D6' §3: the MQTT client lives in a native foreground service. `location` is the type
             that keeps FusedLocation delivering with the screen off. -->
        <service
            android:name=".location.PositionForegroundService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- E-01. A backgrounded app has no socket (`signalr-hub.md` §6), so this is the only
             delivery path for an offer that has 15 seconds to live. -->
        <service
            android:name=".push.DriverMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- US-9A.19's statement download (SCR-DA-025, C073). A wallet statement is written to
             the app's own cache and handed out through a per-file read grant rather than saved
             into shared storage: that needs no permission on any API level this app supports
             (WRITE_EXTERNAL_STORAGE is API ≤ 28 only and MediaStore is API 29+, so the shared-
             storage route would be two code paths and one more permission for the same file),
             and the grant dies with the chooser. `grantUriPermissions` is what makes the grant
             possible at all; the paths are in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="ride_offers" />

    </application>
</manifest>
