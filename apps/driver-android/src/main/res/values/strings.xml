    <!-- SCR-DA-007 · permissions. -->
    <string name="permissions_title">Allow permissions</string>
    <string name="permissions_intro">Driver mode needs these to receive trips and share your location.</string>
    <string name="permissions_continue">Continue to dashboard</string>
    <string name="permission_location_title">Location</string>
