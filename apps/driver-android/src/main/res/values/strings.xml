<?xml version="1.0" encoding="utf-8"?>
<!--
  MageRide Driver — shell strings (C067 driver-android-shell). English, the fallback locale.

  SCOPE. Only what the SHELL renders lives here: the app label, the bottom-nav tabs, the offline
  banner, the update gate, the two notification channels and the foreground-service notification,
  plus the handful of actions and errors every screen group shares. A screen group's own copy
  belongs to that component (C068-C075) and is added to all three files together.

  THE RULE (CLAUDE.md). Every user-facing string is Si + Ta + En, and nothing is hard-coded in a
  composable. `StringResourceTest` fails the build if a key exists here and not in values-si or
  values-ta, if a translation is left equal to the English, or if a format string does not carry
  the same placeholders in all three.

  ORDER. Si -> Ta -> En is the language ORDER the onboarding screen offers (AL-26); it is not the
  fallback order. Android resolves an untranslated key to this file, which is why every key must
  be present in the other two rather than relying on it.
-->
<resources>

    <!-- Launcher label. The brand name is not translated; the descriptor beside it is. -->
    <string name="app_name">MageRide Driver</string>

    <!-- Bottom navigation (AL-31). Four tabs; Menu is the entry point that replaces the
         hamburger the dashboard must not have. -->
    <string name="nav_home">Home</string>
    <string name="nav_jobs">Jobs</string>
    <string name="nav_wallet">Wallet</string>
    <string name="nav_menu">Menu</string>

    <!-- Offline banner (US-15.6, SCR-*-032): a top banner, never a full takeover. -->
    <string name="offline_banner_message">Connection lost — showing last known</string>
    <string name="offline_banner_restored">Back online</string>

    <!-- App-update gate (D-31). `mandatory` blocks; `optional` is dismissible. -->
    <string name="update_required_title">Update required</string>
    <string name="update_mandatory_message">A newer version of MageRide Driver is needed to continue.</string>
    <string name="update_optional_message">A newer version of MageRide Driver is available.</string>
    <string name="update_action_now">Update now</string>
    <string name="update_action_later">Later</string>

    <!-- Foreground service (D6' §3). Its notification is the driver visible proof that the app is
         publishing position, so the text says what is being shared, not that a service is running. -->
    <string name="location_channel_name">Location sharing</string>
    <string name="location_channel_description">Keeps your position live while you are online or on a trip.</string>
    <string name="location_notification_title">MageRide Driver is online</string>
    <string name="location_notification_text">Sharing your location</string>
    <string name="location_notification_buffering">Offline — %1$d positions saved</string>
    <string name="location_notification_stop">Go offline</string>

    <!-- Push channels (E-01). Ride offers are high importance; everything else is not. -->
    <string name="push_channel_rides_name">Ride offers</string>
    <string name="push_channel_rides_description">Hire offers, ride updates and cancellations.</string>
    <string name="push_channel_general_name">General</string>
    <string name="push_channel_general_description">Announcements, wallet and account notices.</string>

    <!-- Shared actions and errors. -->
    <string name="action_retry">Retry</string>
    <string name="action_dismiss">Dismiss</string>
    <string name="action_close">Close</string>
    <string name="action_continue">Continue</string>
    <string name="action_back">Back</string>
    <string name="action_tap_to_capture">Tap to capture</string>
    <string name="status_done">Done</string>
    <string name="error_generic">Something went wrong. Please try again.</string>
    <string name="session_expired">Your session ended. Please sign in again.</string>

    <!-- D-26: an app resolves its copy from a problem+details `code`, never from the server's own
         English `title`/`detail`. These are the codes cluster 1 can meet (C068). -->
    <string name="error_offline">No connection. Check your network and try again.</string>
    <string name="error_otp_invalid">That code is wrong. Try again.</string>
    <string name="error_otp_expired">That code has expired. Ask for a new one.</string>
    <string name="error_otp_locked">Too many wrong codes. Try again later.</string>
    <string name="error_otp_rate_limited">Too many attempts. Wait a while before asking again.</string>
    <string name="error_device_mismatch">This code was sent to another device.</string>
    <string name="error_user_blocked">This number cannot sign in. Contact support.</string>
    <string name="error_validation_failed">Check what you entered and try again.</string>
    <string name="error_upload_unavailable">Documents cannot be uploaded on this build yet.</string>

    <!-- ==========================================================================
         C068 · SCR-DA-001…003a + 007 — first run.
         ========================================================================== -->

    <!-- SCR-DA-002 · language / city. The three language names themselves are NOT here: an
         endonym is the same string in all three files, which this file's own rule forbids.
         See `LanguageCityScreen.endonym`. -->
    <string name="onboarding_welcome_title">Welcome</string>
    <string name="onboarding_language_label">Language</string>
    <string name="onboarding_city_label">Operating city</string>
    <string name="onboarding_city_load_failed">Could not load the city list.</string>

    <!-- AL-28's three feature slides (BR-25.1). Presentation only — nothing here gates anything. -->
    <string name="onboarding_slide_earn_title">Go online and earn in seconds</string>
    <string name="onboarding_slide_earn_body">Onboard your vehicle, accept hires in 15 seconds, set Directional Travel, and track your wallet and daily fee — all in one app.</string>
    <string name="onboarding_slide_earn_caption">Getting started</string>
    <string name="onboarding_slide_dispatch_title">A hire in 15 seconds</string>
    <string name="onboarding_slide_dispatch_body">Offers reach you with the pickup, the drop-off and the fare, and a 15-second timer. Accept and go.</string>
    <string name="onboarding_slide_dispatch_caption">Dispatch</string>
    <string name="onboarding_slide_wallet_title">Wallet and daily fee in one place</string>
    <string name="onboarding_slide_wallet_body">See every earning, top up inside the app, and pay your daily fee without leaving it. Your first trip each day is free.</string>
    <string name="onboarding_slide_wallet_caption">Wallet</string>

    <!-- SCR-DA-003 · phone + OTP. The `7X XXX XXXX` mask is a constant in `PhoneNumber`, not a
         string: it is the same characters in all three languages. -->
    <string name="login_title">Driver mobile number</string>
    <string name="login_phone_otp_only">Phone and OTP only — there is no Google sign-in.</string>
    <string name="login_enter_code">enter code</string>
    <string name="login_resend_code">No code yet?</string>
    <string name="login_resend_action">Resend</string>
    <string name="login_resend_in">in %1$d s</string>
    <string name="login_attempts_remaining">%1$d attempts left</string>

    <!-- SCR-DA-003a · profile setup. -->
    <string name="profile_setup_title">Set up your profile</string>
    <string name="profile_setup_photo_caption">Profile photo — shown to passengers</string>
    <string name="profile_setup_photo_required">required</string>
    <string name="profile_setup_photo_action">Choose a profile photo</string>
    <string name="profile_setup_name_label">Driver name</string>
    <string name="profile_setup_licence_label">Driving licence (front and back)</string>
    <string name="profile_setup_licence_front">Front</string>
    <string name="profile_setup_licence_back">Back</string>
    <string name="profile_setup_extract_title">Read from your licence · personal details redacted</string>
    <string name="profile_setup_field_licence_no">Licence no</string>
    <string name="profile_setup_field_expiry">Expiry</string>
    <string name="profile_setup_field_nic">NIC no</string>
    <string name="profile_setup_field_allowed_types">Allowed vehicle types</string>
    <string name="profile_setup_field_unread">Not read</string>
    <string name="profile_setup_nic_label">National identity card no</string>
    <string name="profile_setup_allowed_types_label">Vehicle types your licence allows</string>
    <string name="profile_setup_manual_supporting">Type it in if the scan could not read it.</string>
    <string name="profile_setup_manual_title">Needs checking</string>
    <string name="profile_setup_manual_body">Anything you typed in yourself goes to a verification officer. You can carry on in the meantime.</string>
    <string name="profile_setup_save">Save and continue</string>

