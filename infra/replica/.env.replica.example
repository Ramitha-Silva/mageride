# =====================================================================================
# infra/replica/.env.replica.example — the replica's own overrides.
#
# `deploy.sh` copies this to `.env.replica` on first run and fills every CHANGEME with a freshly
# generated value. `.env.replica` is gitignored (.gitignore line 85, `.env.*`); this example file is
# committed and must never carry a real secret.
#
# Loaded LAST by the compose file, after env/.env.common.example and env/.env.app.example, so
# anything here wins. Only put a value here if the replica genuinely differs from the dev defaults.
# =====================================================================================

# --- secrets, generated per deployment ----------------------------------------------
# Every one of these is a `${VAR:?}` in the compose file, so the stack refuses to start rather than
# booting with a default somebody forgot to change. That is deliberate: the replica's edge is
# publicly reachable.
PG_PASSWORD=CHANGEME_POSTGRES
MQTT_JWT_SECRET=CHANGEME_MQTT_JWT
MINIO_ROOT_PASSWORD=CHANGEME_MINIO_ROOT
# MinIO's SSE-KMS key is `name:base64-of-32-bytes`. deploy.sh generates the base64 half.
MINIO_KMS_SECRET_KEY=mageride-replica-key:CHANGEME_MINIO_KMS_BASE64

# --- identity -----------------------------------------------------------------------
# Used for the self-signed certificate's CN/SAN and the portals' NEXT_PUBLIC_API_BASE_URL.
REPLICA_HOSTNAME=replica.mageride.lk
# LiveKit needs the address a browser will reach it on; only used with `--profile voip`.
REPLICA_PUBLIC_IP=127.0.0.1

# --- exposure -----------------------------------------------------------------------
# 0.0.0.0 publishes the edge on every interface, which is what a demo needs and what the spec's
# Container 1 describes. Set 127.0.0.1 for a run that only has to satisfy the smoke suite — nothing
# else in the stack publishes a port either way.
REPLICA_EDGE_BIND=0.0.0.0

# --- object store --------------------------------------------------------------------
# env/.env.common.example points Storage__S3__* at http://minio:9000 with the DEV credentials
# (mageride_dev / mageride_dev_secret). The replica generates its own MinIO root password, so those
# would not authenticate. deploy.sh appends the matching pair below this line.

# --- GTFS feed downloads (Δ C126) ----------------------------------------------------
# The HMAC that signs SCR-AP-016's "download original zip" link (US-28.3). `…/versions/{id}/download`
# answers a 302 and a browser following a redirect does not carry the bearer that authorised it, so
# this signature IS the credential on `GET /v1/admin/transit/gtfs/objects/{id}` — the stand-in for a
# presigned object-storage URL until an S3 client exists.
#
# env/.env.app.example ships `CHANGEME_gtfs_download_signing_key_base64`, which is a real, non-empty,
# PUBLISHED constant: TransitOptions accepts it, so nothing fails, and anybody with the repository can
# mint a valid link to any feed version on a publicly reachable edge. Generated per deployment here
# for the same reason MQTT_JWT_SECRET is.
Transit__Gtfs__DownloadSigningKey=CHANGEME_GTFS_SIGNING

# --- the SCR-AP-016 day-0 operator (Δ C126) ------------------------------------------
# GTFS_ADMIN_EMAIL / GTFS_ADMIN_PASSWORD, appended to .env.replica by infra/replica/gtfs-lib.sh on
# first use — so there is normally nothing to do here.
#
# Left out of the EXAMPLE, and out of seed.sql, on purpose. The replica's seed has no internal
# account at all (every synthetic actor is a passenger, a driver or a fleet owner), so SCR-AP-016 had
# nobody who could open it; but a committed seed means a committed PBKDF2 verifier for a known
# password, on a box with a public IP. The password is generated per deployment into this file, which
# is gitignored and is where every other replica credential already lives.
#
# The account is `role = 'admin'` and synthetic. Anything else in Wave 5/6 that needs an Admin bearer
# should `. infra/replica/gtfs-lib.sh` and call `require_token` rather than provision a second one.

# --- the seeder ---------------------------------------------------------------------
# SYNTHETIC DATA ONLY. seed.sh refuses to run against a database that already holds rows it did not
# create, and this is the marker it writes and looks for.
REPLICA_SYNTHETIC_MARKER=mageride-replica-synthetic

# --- geocoding ----------------------------------------------------------------------
# Nominatim runs on its OWN VPS (the spec: 8 GB, "too heavy to co-locate") and is deployed by
# infra/replica/nominatim/deploy-nominatim.sh, which appends the line below to .env.replica itself —
# so there is normally nothing to do here.
#
# Left commented in the EXAMPLE on purpose: the address belongs to a deployment, not to a template.
#
# It overrides env/.env.app.example's `Query__NominatimBaseUrl=http://nominatim:8080/`, which names a
# CONTAINER — right for a stack with nominatim in it, wrong for this one, where the geocoder is on
# another box and that hostname does not resolve.
#
# QUERY, not TRANSIT: Nominatim is query-svc's, behind GET /v1/geo/search and /v1/geo/reverse.
# transit-svc's /v1/geo/parse-maps-link shares the URL prefix and resolves a short Google-Maps link to
# a lat/lng without touching a geocoder. Unset, /v1/geo/reverse answers 503 and /v1/geo/search falls
# back to the caller's saved and recent places — a real answer, said loudly at start-up so it is not
# mistaken for a working geocoder. There is no Google Places fallback and there must never be one
# (D3' map hard rule, D-14).
#
# SET, not commented: this is the actual address of the geocoder VPS. It has no domain name, so a
# bare IP is the real value rather than a placeholder somebody has to replace.
Query__NominatimBaseUrl=http://45.77.37.208:8080

# =====================================================================================
# ocr-svc — the Gemini key (Δ MCS-07)
# =====================================================================================
# BELONGS HERE, not in ../env/.env.app.example, and it is the one OCR value that does.
#
# `.env.app.example` ships `Ocr__Gemini__ApiKey=CHANGEME_gemini_api_key`. That placeholder is
# NON-EMPTY, so `GeminiFieldExtractor.IsConfigured` answered true, ocr-svc logged "Gemini
# configured" at start-up, the "not configured" warning never fired — and every extraction was
# rejected by Google and fell through to Tesseract. Nothing on the platform could tell the
# difference from the outside, which is exactly the failure mode ocr-svc's own CLAUDE.md warns
# about ("a disarmed redactor looks exactly like a working one").
#
# `deploy.sh` now refuses to start when a CHANGEME survives in the APP env layer too, not just in
# this file, so an unset key is a loud failure rather than a quiet degradation.
#
# COMMENTED here because a key is a deployment's, not a template's — the real value goes in the
# host's own gitignored `.env.replica`, which this file is only the seed for.
#Ocr__Gemini__ApiKey=
