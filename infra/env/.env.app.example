# =====================================================================================
# .env.app — D7' §4.2 per-service additions (C009)
#
# Loaded after .env.common by `app-services`, `hot-path`, `fanout`, `tcp-adapter` and
# `api-gateway`. Copy to `infra/env/.env.app` (gitignored) to override locally.
#
# D7' §3 gives only `app-services` this file, but §4.2 has rows for position-processor,
# persistence-writer, mqtt-bridge and fleet-health (the four services inside `hot-path`),
# for fanout-svc and for tcp-adapter. Those variables have to reach the process that reads
# them, so all four containers load it. **Micro-change-set for D7' §3.**
#
# Since the replica co-locates 21 domain services in one process, the keys below are a
# single flat namespace — `Onepay__ApiKey` is read by both fare-svc and wallet-svc, and
# `Otp__*` is iam-svc's OTP policy while ride-svc's pickup OTP pepper is
# `Otp__PepperKey`. When production splits the services into separate pods each gets only
# its own rows, and the collisions disappear.
#
# Secrets are `CHANGEME_*` placeholders. Every one of them is marked **yes** in the D7'
# §4.2 Secret column and is sourced from Vault in the replica and in production (D7' §13).
# =====================================================================================

# =====================================================================================
# iam-svc — auth (D-29, D-32, AL-07, AL-37)
# =====================================================================================
# Notify.lk is the primary SMS gateway (D6' §7.3). Set `Sms__Provider=notifylk` to use it —
# it then needs both credentials below or iam-svc refuses to start, because a service that
# boots healthy and delivers no OTP is a service nobody can sign in to. Left unset here so a
# copied-and-not-yet-filled-in file still starts: the default is the dev sender, which logs
# the code instead of sending it and is itself refused outside Development.
# Sms__Provider=notifylk
Sms__NotifyLkUserId=CHANGEME_notify_lk_user_id
Sms__NotifyLkApiKey=CHANGEME_notify_lk_api_key
Sms__NotifyLkSenderId=MageRide
# RS256 private key, PEM. Rotated every 90 days with a JWKS overlap (D7' §13): the outgoing
# key moves to Jwt__RetiredSigningKeyPems__0 for one deploy, so tokens signed by it keep
# validating, and is deleted in the deploy after that.
Jwt__SigningKeyPem=CHANGEME_rs256_private_key_pem
Jwt__RetiredSigningKeyPems__0=
# Not in D7' §4.2 — C026 micro-change-set. Without it the refresh HMAC is derived from the
# signing key, so the 90-day rotation above logs every user out.
Jwt__RefreshTokenKey=CHANGEME_refresh_token_hmac_key
Otp__ResendCooldownSec=60
Otp__MaxPerHour=5
# Admin Portal (password/Google) and Fleet Portal (email/Google/Apple). The mobile apps
# are Phone-OTP only (AL-07), so these are optional — but an EMPTY client-id list refuses
# every provider token rather than accepting all of them, which is deliberate: validating
# without an audience would accept an ID token minted for anybody else's OAuth client.
# **These four keys replace the `Google__ClientId` / `Apple__ClientId` pair this file used
# to carry** — neither matched anything the service binds. C026 micro-change-set.
Oidc__Google__ClientIds__0=
Oidc__Google__ClientSecret=
Oidc__Google__RedirectUri=https://admin.mageride.lk/auth/callback
Oidc__Apple__ClientIds__0=
# AL-37's compensating controls, enforced in iam-svc's own handlers (not in admin-bff).
# The allow-list is OFF while empty; add CIDRs to turn it on for the six internal roles.
Auth__MaxFailedAttempts=5
Auth__LockoutDuration=00:15:00
Auth__InternalRoleIpAllowList__0=
# C027, not in D7' §4.2. HMAC key for `iam.phone_lookups.phone_hash` (P-03) — REQUIRED outside
# Development, because an unkeyed digest of a `+947XXXXXXXX` number is a 10^8 offline search and
# so not a hash of anything. **Not rotatable in place**: every existing digest is keyed with the
# old value, so a new key partitions the table rather than re-keying it. Deliberately not
# `Otp__PepperKey`, which guards a five-minute code and is rotated freely.
Auth__PhoneHashKey=CHANGEME_iam_phone_lookup_hmac_key
# C027, not in D7' §4.2. Guards GET /v1/users/lookup — the P-03 registration oracle ride-svc
# calls to decide between an in-app FCM location request and the SMS pickup-confirm path. The
# route is NOT under the /v1/internal/** prefix the gateway refuses (C008) and the `iam-users`
# gateway route forwards it from the public internet, so the service authenticates it itself
# until C042 lands a mesh. UNSET means the route is not mapped at all — a deployment that forgets
# it gets 404s and a broken proxy booking, not an open door.
Auth__InternalApiKey=CHANGEME_iam_internal_service_key
# `Mfa__IssuerName` and `Mfa__RequiredForInternal` are deliberately ABSENT. AL-37 removed
# the second factor for internal roles; D3' §0 and D7' §4.2's admin-bff row still describe
# it, and planner finding 3 resolves that in AL-37's favour. The compensating controls are
# the two keys directly above, plus the session binding the `device_id` claim gives.

# =====================================================================================
# registry-svc — registration + OnePay merchant binding (D-11)
# =====================================================================================
Ocr__Endpoint=http://app-services:5000/v1/internal/ocr
Onepay__MerchantOnboardingUrl=https://merchant.onepay.lk/onboarding
# C021, not in D7' §4.2. Maps POST /v1/dev/vehicles/{id}/approve, which flips a vehicle to
# APPROVED **without** AL-10's mandatory insurance document or the AL-30 onboarding steps.
# Unset = Development only. The lightweight production replica runs synthetic data under the
# Production environment name and needs it; a real deployment must leave it unset or false.
Registry__DevApprovalEnabled=true
# C028, not in D7' §4.2. Guards POST /v1/internal/vehicles/{id}/merchant — the D-11 OnePay binding
# fare-svc writes when a vehicle reaches APPROVED. Must equal what fare-svc (C046) sends. D3' §0
# puts the internal family on service-to-service mTLS and the gateway already refuses the prefix at
# the edge (C008); the shared secret is the interim until C042 lands a mesh. UNSET means the route
# is not mapped at all — no driver gets a payee, which surfaces as 402 merchant-not-onboarded at
# POST /v1/fare/pay rather than as anything pointing at registry-svc.
Registry__InternalApiKey=CHANGEME_registry_internal_service_key
# C028. registry.outbox (migration 0309) drains share.revoked (D-22) to `registry.events` — a
# topic D6' §2.1's six-topic registry does not carry; see the C028 handoff.
#
# The `Registry__` prefix is deliberate and these three bind NOTHING, for exactly the reason the
# `Dispatch__Outbox__*` block below records: this file is one flat namespace shared by every
# co-located service, and ride-svc's unprefixed `Outbox__Channel=ride_outbox` is 40 lines down.
# `RegistryApplication` sets these as its own defaults in code, so the service is correct with or
# without them, and they stay here as the documented per-service values for the day production
# splits the pods.
Registry__Outbox__Channel=registry_outbox
Registry__Outbox__Schema=registry
Registry__Outbox__Topic=registry.events
# C029, not in D7' §4.2. The confidence at or above which an ocr-svc field is auto_verified rather
# than sent to the Verification Officer (AL-29). No spec pins the number — AL-29, BR-25.2 and
# D6' §7.5 all say "below threshold" and none says what it is. Bounded at 0.5 in code, so it
# cannot be turned into "trust everything"; a field with NO confidence is treated as a low one.
Registry__OcrConfidenceThreshold=0.80
# C029. E-03's document-expiry tracker: emits document.expiring at T-30d/-7d/-1d and, on expiry,
# document.expired plus DISPATCH_SUSPENDED on every vehicle the document covers. ON by default —
# a deployment that silently skipped it would keep dispatching expired insurance. E-03 says
# "nightly" and the interval is hourly on purpose: registry.document_notices (migration 0312)
# makes every extra pass free, so a restart or a deployment window cannot cost a night.
Registry__DocumentExpiryEnabled=true
Registry__DocumentExpiryInterval=01:00:00

# =====================================================================================
# provisioning-svc — device PKI (T-02)
# =====================================================================================
# C030. StepCa__Url is the D7' §4.2 row and is DELIBERATELY EMPTY: provisioning-svc ships an
# embedded issuer that keeps root and intermediate in step-ca's own layout under
# StepCa__RootKeyPath, and a URL set here is refused at start-up rather than ignored — a
# deployment that set it believes its root key lives in step-ca's store and not on a volume.
StepCa__Url=
# dev-up.sh generates the CA into infra/deploy/device-ca and both this container and the EMQX
# container mount it; EMQX loads certs/ca_chain.crt as the 8883 listener's cacertfile.
StepCa__RootKeyPath=/var/step
Cred__RotationDays=90
# How long before expiry a credential is replaced. The outgoing one keeps working until it
# expires: a tracker parked out of GSM coverage has to be able to come back for the new one,
# and a rotation that revoked as it minted would brick exactly those devices.
Cred__RotationLeadTime=14.00:00:00
# Written into each certificate as its CRL distribution point, and left EMPTY in dev on
# purpose. EMQX refuses a certificate whose CRL it cannot fetch, and the broker starts before
# this service does — turn this on together with `enable_crl_check` in
# infra/deploy/emqx/emqx.conf, never separately (T-12, MQTT path).
StepCa__CrlDistributionPoint=
# T-08's window. Two devices claiming one IMEI inside it quarantine BOTH; outside it the older
# binding is treated as stale and superseded, because an operator moving a tracker to another
# vehicle a week later has cloned nothing.
Provisioning__AntiCloneWindow=24:00:00
# Shared secret for /v1/internal/trackers/** until C042 lands a mesh. Must equal what the
# tcp-adapter sends. UNSET MEANS THE ROUTES ARE NOT MAPPED — the adapter then refuses every
# device, which is the safe direction to fail in.
Provisioning__InternalApiKey=mageride-dev-provisioning-internal-key-change-me
# Signs the bulk error-report links (T-09). A deployment with more than one replica must set
# this or a link minted by one will not verify on another.
Provisioning__ErrorReportSigningKey=mageride-dev-error-report-key-change-me

# =====================================================================================
# query-svc — map data (D-14)
# =====================================================================================
Tiles__BaseUrl=https://tiles.mageride.lk
# The replica hosts Nominatim on a SEPARATE VPS — 8 GB is a third of this box's budget
# (lightweight-production-replica.md). Empty here means geocoding is unavailable in dev.
Nominatim__Url=

# =====================================================================================
# trip-state-svc — Mode A/B sessions (D-03)
# =====================================================================================
Session__IdleTimeoutMin=30
Geofence__AutoEndM=100

# =====================================================================================
# ride-svc — the Mode C ride aggregate (R-01, P-07, E-09)
# =====================================================================================
# HMAC pepper for the pickup/delivery OTP (P-07). Never the same value as any JWT key.
Otp__PepperKey=CHANGEME_ride_otp_hmac_pepper
Quartz__SchedulerName=mageride-ride
# ⚠ Prefixed by C028, and these three now bind NOTHING. They were unprefixed until C028 and that
# was a live trap: this file is one flat namespace shared by every co-located service, and an
# unprefixed `Outbox__Channel` is bound by the kernel's `Outbox` section AFTER each service's own
# code defaults — so `Outbox__Channel=ride_outbox` here silently pointed **dispatch-svc's and
# registry-svc's** dispatchers at ride-svc's channel, table and topic. `DispatchApplication` and
# `RegistryApplication` both set their own three in code and were still overridden by this.
# ride-svc needs none of them: the kernel's OutboxOptions defaults already describe
# rides / ride_outbox / ride.events exactly (C002). Recorded in the C028 handoff.
Ride__Outbox__Channel=ride_outbox
Ride__Outbox__Schema=rides
Ride__Outbox__Topic=ride.events
# C022, not in D7' §4.2. Guards /v1/internal/rides/** — the two moves dispatch-svc drives
# (Requested -> Matching -> Offered). D3' §0 puts the whole internal family on service-to-service
# mTLS and the gateway already refuses the prefix at the edge (C008), but no mesh exists until
# C042, so the in-cluster hop carries a shared secret. UNSET means the routes are not mapped at
# all — dispatch-svc then places no offers and no driver is ever asked.
Ride__InternalApiKey=CHANGEME_ride_internal_api_key
# D5' §3.5's 15 s offer window, used when dispatch-svc sends no ttlSeconds. ride-svc's clock
# stamps offer_expires_at, because it is ride-svc's `offer_expires_at > now()` that decides an
# accept (ADD §11.11).
Ride__OfferTtl=00:00:15

# =====================================================================================
# dispatch-svc — matching, job board, directional (D-06, D-08, R-04)
# =====================================================================================
# D5' §3.5 / US-6A.3. What dispatch ASKS for; ride-svc stamps the actual deadline from its own
# clock, because it is ride-svc's `offer_expires_at > now()` that decides an accept (ADD §11.11).
Dispatch__OfferTtl=00:00:15
# C023, not in D7' §4.2. The exact-distance post-filter's radius (D5' §3.1's `searchRadius`,
# which no spec gives a value for — recorded as a gap in the C023 handoff). The H3 res-5 ring(2)
# pre-filter reaches ~40 km and is NEVER a distance bound (R-06); this is what decides.
Dispatch__SearchRadiusM=5000
Dispatch__H3Resolution=5
Dispatch__H3RingK=2
# Bounds the D5' §3.5 cascade. The US-6A.11 120 s ExpiredNoDriver timeout is C034's — no route
# exists to write that ride state yet, so this is what stops the loop.
Dispatch__MaxOfferRounds=8
# Must equal ride-svc's Ride__InternalApiKey, or every offer is answered 404 and no driver is
# ever asked — which from the outside looks exactly like "nobody is online".
Dispatch__RideServiceBaseUrl=http://dispatch-needs-ride-svc:8080
Dispatch__RideServiceInternalKey=CHANGEME_ride_internal_api_key
Dispatch__GlobalTimeoutSec=120
JobBoard__RadiusKm=30
Wallet__CacheTtlSec=5
# dispatch.outbox does not appear in either DDL source; C004 created it because D6' §2.4
# names dispatch-svc as an outbox writer and offer.created is the event R-13 exists for.
#
# The `Dispatch__` prefix is deliberate and these three bind NOTHING (C023). This file is one
# flat namespace shared by every co-located service — see the header — and ride-svc's
# `Outbox__Channel=ride_outbox` is 20 lines above; an unprefixed key here would silently point
# ride-svc's dispatcher at the dispatch channel. `DispatchApplication` sets exactly these three
# as its own defaults in code instead, so the service is correct with or without them, and they
# stay here as the documented per-service values for the day production splits the pods.
Dispatch__Outbox__Channel=dispatch_outbox
Dispatch__Outbox__Schema=dispatch
Dispatch__Outbox__Topic=dispatch.events

# =====================================================================================
# fare-svc — payment (D-10)
# =====================================================================================
# C022, not in D7' §4.2. HMAC key behind `fareEstimateToken`: fare-svc signs a quote with it and
# ride-svc verifies it, so BOTH services must be given the same value or every booking is a
# 400 invalid-fare-token. There is deliberately no default — a token signed with a well-known
# key is one a client can mint for itself, and naming your own fare is exactly what the token
# exists to stop.
Fare__EstimateTokenKey=CHANGEME_fare_estimate_token_hmac_key
# How long a quote stays bindable. No spec fixes it; 15 minutes is long enough to compare tiers
# and short enough that a peak window cannot open underneath the price (D5' §1.1).
Fare__EstimateTokenTtl=00:15:00
Onepay__ApiKey=CHANGEME_onepay_api_key
Onepay__WebhookSecret=CHANGEME_onepay_webhook_secret
LankaQr__MerchantId=CHANGEME_lankaqr_merchant_id

# =====================================================================================
# subscription-svc — daily fee (D-13)
# =====================================================================================
Fee__FirstTripFree=true
Tz=Asia/Colombo

# =====================================================================================
# wallet-svc — driver wallet on the double-entry ledger (D-09, D-12, AL-05, C046)
# =====================================================================================
# US-9.9 / D5' §9.4: Rs 200. Edge-triggered — a driver already below it who spends again is
# not warned twice, so this is a threshold to cross rather than a state to be in.
LowBalance__ThresholdMinor=20000

# The OnePay rail (D6' §7.1). Card and OnePay-wallet are one rail and one route.
# Unset ApiKey/BaseUrl ⇒ POST /v1/wallet/topup/onepay answers 503 and only LankaQR works.
Onepay__BaseUrl=https://api.onepay.lk/v3/
# `Onepay__ApiKey` is in the fare-svc block above — one flat namespace, one key, both
# services (see this file's header). It is the same OnePay merchant either way.
#
# THE WEBHOOK SECRET IS WHAT MAKES A TOP-UP ARRIVE. Unset, every OnePay callback is
# refused: the driver pays at the gateway and is never credited, and nothing errors on the
# way. There is no "accept unsigned" mode — a wallet-credit endpoint that trusts an
# unsigned body is a free-money endpoint. wallet-svc says so at error level on start-up.
Onepay__WebhookSecret=CHANGEME_onepay_webhook_secret

# `ComBankIpg__WebhookSecret` NOW HAS A CONSUMER, which supersedes the C007 note that used
# to stand here ("no service reads this key; §4.2 should drop it"). AL-05 withdrew bank
# transfer as a *top-up method* and D6' §7.2 keeps the Commercial Bank IPG webhook for the
# LankaQR rail — the bank is that rail's acquirer (D-12) — so this is the secret
# POST /v1/wallet/topup/lankaqr/confirm is verified against. Unset ⇒ every LankaQR confirm
# is refused. `LankaQr__WebhookSecret` is accepted as an alias for a deployment that would
# rather name it after the rail than after the bank.
ComBankIpg__WebhookSecret=CHANGEME_lankaqr_confirm_webhook_secret

# AL-15: the LankaQR top-up returns a "Pay" DEEP LINK into the bank app, with the QR as the
# fallback. `{orderId}`, `{amountMinor}` and `{merchantId}` are substituted.
# No spec gives the scheme — it belongs to the bank — so unset ⇒ that rail answers 503.
LankaQr__DeepLinkTemplate=combank://pay?ref={orderId}&amount={amountMinor}&mid={merchantId}
# `LankaQr__MerchantId` is in the fare-svc block above, for the same reason as the OnePay key.
#
# The QR fallback is DELIBERATELY not generated: a LankaQR payload is an EMVCo TLV string
# whose merchant fields and CRC belong to the acquiring bank, and a composed one would be a
# plausible, unscannable code in front of a driver. Set it only with a payload the bank gave
# you; unset, `qrPayload` is omitted and the deep link is the only route.
#LankaQr__PayloadTemplate=

# mTLS interim (D3' §0) for /v1/internal/wallet/**. UNSET ⇒ THOSE ROUTES ARE NOT MAPPED, and
# every service that moves a driver's money without owning the ledger fails inside itself:
# subscription-svc cannot charge the D-13 daily fee (C047), fare-svc cannot settle a D-05
# penalty or pay out a tip (C049/C050), admin-bff cannot reverse a fee (C065). Each of those
# must present this value.
Wallet__InternalApiKey=CHANGEME_wallet_internal_service_key

# D-08 / D5' §9.2. **Must equal `Dispatch__WalletCacheTtl`** — two halves of one key:
# dispatch-svc populates wallet:bal:{driverId} on a miss and wallet-svc writes through on
# every movement. Off ⇒ a top-up is invisible to the dispatch gate for up to that TTL.
Wallet__BalanceCacheTtl=00:00:05
Wallet__BalanceCacheEnabled=true

# Bounds. No spec pins any of them; each is argued at its declaration in WalletOptions.
# The floor is below the cheapest daily fee, so a driver can always top up exactly what they
# need; the ceiling is ten times the largest voucher.
Wallet__MinTopupMinor=5000
Wallet__MaxTopupMinor=10000000
Wallet__MaxTransferMinor=10000000
Wallet__MaxStatementRows=10000
# D6' §7.1's 90-second pending window. READ, never swept: a callback that arrives late is
# still a payment the driver made. The reconciling status poll §7.1 also asks for needs a
# live OnePay query API and is named in the C046 handoff rather than stubbed.
Wallet__TopupPendingWindow=00:01:30

# =====================================================================================
# notification-svc — push + SMS (E-01, D-33)
# =====================================================================================
Fcm__ServiceAccountJson=CHANGEME_fcm_service_account_json
Apns__P8Key=CHANGEME_apns_p8_key
Apns__KeyId=CHANGEME_apns_key_id
Apns__TeamId=CHANGEME_apns_team_id
# Second SMS gateway (Dialog/Mobitel) — D-33 requires a dual path for SOS. This file is one
# flat map read by every service, so iam-svc reads the same key: it is the OTP fallback when
# Notify.lk refuses or is unreachable (D6' §7.3). SOS sends through both in parallel;
# an OTP tries the primary first and only falls through on failure.
Sms__SecondaryGateway=
Sms__SecondaryApiKey=
Sms__SecondarySenderId=

# =====================================================================================
# safety-svc — SOS + trip share (D-33, D-34)
# =====================================================================================
Sos__SloMs=5000
TripShare__TtlGraceMin=60

# =====================================================================================
# reputation-svc — block_status / level over gRPC
# =====================================================================================
# D7' §4.2, verbatim. C033: this is not a preference. Cleartext HTTP has no ALPN, so Kestrel
# cannot negotiate HTTP/1.1 and HTTP/2 on one socket — the admin routes and `reputation.v1` must
# be different ports or every gRPC call is answered `GOAWAY HTTP_1_1_REQUIRED`. The admin side
# is `Reputation__HttpListenPort` (5000, the address gateway-routes.json points the cluster at)
# or ASPNETCORE_URLS, whichever is set.
Grpc__ListenPort=5005
# C033. Guards `reputation.v1` (as `x-mageride-internal-key` metadata) and
# POST /v1/internal/reputation/observations. D3' §0 puts both on service-to-service mTLS and the
# gateway refuses the internal prefix at the edge (C008); the shared secret is the interim until
# C042 lands a mesh. UNSET means the observation route is not mapped AND the gRPC service accepts
# any in-cluster caller — the service says so loudly at start-up.
Reputation__InternalApiKey=CHANGEME_reputation_internal_service_key
# C033. reputation.outbox (migration 0803) drains fraud.suspected (E-07) and
# reputation.block_state_changed (D-04) to `reputation.events` — a topic D6' §2.1's six-topic
# registry does not carry; see the C033 handoff.
#
# The `Reputation__` prefix is deliberate and these three bind NOTHING, for the same reason the
# `Registry__Outbox__*` block above records: this file is one flat namespace shared by every
# co-located service, and ride-svc's unprefixed `Outbox__Channel=ride_outbox` is elsewhere in it.
# `ReputationApplication` sets these as its own defaults in code, so the service is correct with
# or without them, and they stay here as the documented per-service values for the day production
# splits the pods.
Reputation__Outbox__Channel=reputation_outbox
Reputation__Outbox__Schema=reputation
Reputation__Outbox__Topic=reputation.events

# =====================================================================================
# content-svc — Si/Ta/En templates, FAQ, broadcasts, launch cities, carousel (D-26, C045)
# =====================================================================================
# D7' §4.2's one variable for this service, spelled exactly as it prints it: unprefixed,
# in seconds. content-svc reads it as the default for `Content__CacheTtl` — the TTL its
# two public endpoints also advertise as `Cache-Control: max-age`. It is the number the
# C045 definition of done is written against ("a template change is visible to
# notification-svc within the documented cache TTL"); the cross-replica purge below is
# what makes the usual case immediate rather than merely bounded.
Cache__Ttl=300

# The service's own key wins over `Cache__Ttl` when both are set. TimeSpan, not seconds.
# Left commented so the D7' spelling above is the one in force.
#Content__CacheTtl=00:05:00

# Off makes every notification render a database round trip — E-01 renders one template per
# candidate driver per ride offer, which is the load the cache exists to absorb. Announced at
# start-up when off.
Content__CacheEnabled=true

# A backstop, not a working limit: the five datasets need about a dozen entries between them, and
# one key family (the template key on the internal render route) comes from a caller. At the
# ceiling, expired entries are dropped and reads are served uncached rather than the process growing
# until it is killed.
Content__MaxCacheEntries=1000

# The invalidation path on publish. The cache is in process (these datasets are a few
# hundred rows and the template read is on E-01's push path), so a publish on one replica
# reaches the others as a pub/sub message on `content:invalidate`. Off is not broken — it
# is TTL-only behaviour — but it is a different promise, so the service says so at
# start-up.
Content__InvalidationEnabled=true

# D3' calls `PUT /v1/admin/content/{key}` a "versioned template edit (approval workflow)"
# and `content.notification_templates.approved_by` exists to record who approved it, so
# the default is draft -> `POST /v1/admin/content/{key}/approve`. `true` makes an edit live
# immediately and files the author as their own approver (loses D-35's four eyes).
Content__PublishOnEdit=false

# mTLS interim (D3' §0) for `GET /v1/content/templates/{key}` and
# `POST /v1/internal/content/cache/purge`. UNSET LEAVES THE TEMPLATE READ OPEN to anything
# that reaches this service — and unlike every other internal family it is not under the
# /v1/internal prefix the gateway refuses, because D3' prints it under /v1/content. Unset
# also unmaps the purge route, so an admin-bff city edit waits out `Cache__Ttl`.
# notification-svc (C051) must present the same value.
Content__InternalApiKey=CHANGEME_content_internal_service_key

# AL-28's carousel illustrations are app-bundled asset keys (`onboarding/driver-wallet`).
# Set this to serve them as absolute URLs instead — how the artwork moves to a CDN without
# an app release. No spec pins it and unset is the intended state.
#Content__AssetBaseUrl=https://cdn.mageride.lk/onboarding/

# Bounds on the two list reads. No spec gives either; truncation is logged, never silent.
Content__MaxFaqItems=500
Content__MaxBroadcasts=50

# =====================================================================================
# support-svc — tickets
# =====================================================================================
# Storage__ScreenshotBucket is in .env.common with the other three buckets, since the
# endpoint and credentials it needs are platform-wide and D7' §4 defines neither.

# =====================================================================================
# fleet-svc — Phase 1 (AL-03)
# =====================================================================================
Fleet__RlsEnabled=true
Fleet__VerificationGate=true

# =====================================================================================
# admin-bff — Admin Portal, nine-role RBAC (AL-02, AL-06, D-35, E-06)
# =====================================================================================
Audit__Topic=audit.events
Pdpa__DueDays=30
Rbac__DenyByDefault=true
Login__MaxFailedAttempts=5
Login__LockoutMinutes=15
# Optional CSV of CIDRs. Empty = no IP restriction. With AL-37 removing MFA this and the
# lock-out above are the compensating controls for internal sign-in.
Login__IpAllowList=

# =====================================================================================
# ocr-svc — document OCR + Mode-C auto-verify (D-36)
# =====================================================================================
Gemini__ApiKey=CHANGEME_gemini_api_key
Gemini__Model=gemini-flash-3.0
Redaction__Enabled=true

# =====================================================================================
# voip-svc — free in-app voice (D-24, AL-48)
# =====================================================================================
# Optional in D7' §4.2: the `voip` container is optional and voip-svc returns
# "VoIP unavailable" when LiveKit is unreachable. No masked calling and no DID lease —
# AL-48 withdrew number masking; the fallback is a plain tel: link (D-25).
LiveKit__ApiKey=
LiveKit__Secret=
Turn__Realm=mageride.lk

# =====================================================================================
# position-processor-svc — hot path (D-18, T-05)
# =====================================================================================
Plausibility__MaxAccuracyM=200
Replay__MaxPerSec=20

# =====================================================================================
# persistence-writer-svc — the durable write path (T-06, T-10)
# =====================================================================================
# D7' §4.2 spells this service's two settings under a `Timescale` prefix. Both are still
# honoured as aliases; everything C040 added is under `PersistenceWriter` so one section
# holds the whole service. Set either, not both — the PersistenceWriter name wins.
Timescale__BatchRows=1000
Timescale__FlushMs=500

# ADD §9.5 item 5's batch shape: 1k rows / 500 ms / partition, through binary COPY. The
# deadline runs from a batch's FIRST buffered row, so a vehicle reporting once every thirty
# seconds is not held for as long as the partition keeps receiving other traffic.
PersistenceWriter__BatchRows=1000
PersistenceWriter__FlushInterval=00:00:00.500

# THE BUFFER OF RECORD IS REDPANDA, NOT THIS PROCESS. When Postgres is slow or down,
# flushes fail, offsets stay uncommitted, and at this ceiling the loop stops consuming
# altogether — the backlog then accumulates on telemetry.normalized, which D6' §2.1 retains
# for seven days. An unbounded in-memory queue would turn a database outage into an OOM
# kill, and the restart would replay from the same offset anyway.
PersistenceWriter__MaxBufferedRows=10000
PersistenceWriter__RetryDelay=00:00:00.250
PersistenceWriter__MaxRetryDelay=00:00:10

# D6' §2.3. A batch that fails on a DATA error (SQLSTATE 22/23) will fail identically on
# every retry, so it is re-offered row by row and the bad rows go to
# telemetry.normalized.dlq. Everything else — a dropped connection, a deadlock, a full disk
# — is transient and is retried, because committing past it silently loses telemetry.
# OFF means a poison row stalls its partition instead: loud rather than lossy.
PersistenceWriter__DeadLetterEnabled=true

# ADD §9.2's "1/min sampled". Each row is stamped at its MINUTE BOUNDARY, which is what
# makes an at-least-once writer idempotent against ux_possample_session_minute without any
# per-vehicle memory. Changing the period changes the meaning of rows already stored.
PersistenceWriter__OperationalSamplingEnabled=true
PersistenceWriter__SamplePeriod=00:01:00

# Both lookups cache their MISSES, which is the point: every Mode C vehicle publishes on
# this topic and none has a tracking session (R-01), and most vehicles belong to no fleet.
# The session TTL bounds how late a freshly started journey's first sample can be; fleet
# membership is an admin action measured in months.
PersistenceWriter__SessionCacheTtl=00:00:30
PersistenceWriter__FleetCacheTtl=00:10:00
PersistenceWriter__LookupCacheCapacity=50000

# ADD §9.2's trip summary — start, end, distance, polyline — written on session.ended.
# The tolerance matches D5' §5.2's own Δpos < 25 m coalescing threshold: the simplification
# throws away exactly what the cadence rule would have. The DISTANCE is measured before the
# line is simplified, so the tolerance never shortens a journey.
PersistenceWriter__SummariesEnabled=true
PersistenceWriter__PolylineToleranceM=25
PersistenceWriter__AllowOperationalGeometryFallback=true

# NOTE: this service has no ConnectionStrings__Redis and must not. UseRedis is false in its
# composition root, so it is structurally incapable of touching the live map — which is the
# C040 fence "a slow or failed write must not affect the live map".

# =====================================================================================
# mqtt-bridge-svc — EMQX to Redpanda (E-08)
# =====================================================================================
# C024 replaced C009's `Emqx__SharedSub` / `Emqx__ReplaySharedSub` with the GROUP NAMES.
# The service builds `$share/{group}/veh/+/pos/live` itself (MqttTopics.SharedPositionLive),
# which removes two ways to break E-08 silently: a filter that lost its `$share/` prefix
# makes every replica receive every message — `telemetry.raw` then carries one copy per
# replica and nothing errors — and a filter pointed at the wrong topic subscribes
# successfully to nothing. It also removes the `$$` escaping this block used to need:
# docker compose interpolates env_file values, and a literal `$share` expanded to the
# empty string with a "variable is not set" warning.
#
# Note the group names: the replay group is `posReplayGroup`, not C009's `replayGroup`.
# Any name works as long as every replica agrees, but live and replay must NOT share one —
# R-09 keeps a reconnect storm's backlog off the live path.
MqttBridge__LiveShareGroup=posGroup
MqttBridge__ReplayShareGroup=posReplayGroup

# Without the `svc-` prefix acl.conf grants nothing: `$share/#` and the `veh/#` wildcard
# are the `svc-` principal's alone. The service adds the prefix, so this is the bare name.
#
# It is `MqttBridge__ServiceName`, not the `Mqtt__ServiceUsername` C009 used here, and that
# is not only cosmetic: env_file entries are one flat map, so the `Mqtt__ServiceUsername`
# in the tcp-adapter block below would otherwise win for every container that reads this
# file — the compose `hot-path` service sets it again in `environment:` purely to undo that.
MqttBridge__ServiceName=mqtt-bridge

# Consume the backlog stream as well as the live one. A topic nobody consumes is a
# vehicle whose offline history is silently lost. The backlog gets its own broker
# session as well as its own share group: one session holding both filters would share
# an MQTT inflight window, and 32 throttled backlog samples would stall live delivery on
# the same socket — which is the failure R-09 is written against.
MqttBridge__ConsumeReplay=true

# --- T-05: the backlog rate limit (C038) ----------------------------------------------
# ADD §7.5.2: "max 20 backlog samples/s/vehicle on veh/{vehicleId}/pos/replay". The bucket
# lives in Redis, not in the replica: the replay share group hands each replica a random
# slice of one device's backlog, so an in-process bucket would let N replicas pass N × 20
# samples/s and R-09's "hard rate limit" would be a limit on nothing. Capacity equals the
# rate — no burst credit, because a tracker that has been offline for an hour spending an
# hour of accumulated tokens at once IS the reconnect storm.
#
# Over-rate samples wait, they are not dropped: a backlog is a vehicle's history. The wait
# reaches EMQX as unacknowledged QoS 1 messages filling the session's inflight window,
# which is where ADD §7.5.2 wants the back-pressure.
MqttBridge__ThrottleReplay=true
MqttBridge__ReplaySamplesPerSecond=20

# How long one backlog sample may wait before the bridge sheds it (unacknowledged, so EMQX
# still has it), and how many may queue per device before it stops accepting. Neither is
# normally reached — the broker's 32-message inflight window is the first back-pressure.
MqttBridge__ReplayMaxWait=00:00:30
MqttBridge__ReplayQueueDepth=256
MqttBridge__ReplayLaneIdleTimeout=00:05:00

# --- D-17: the live publish ceiling (C038) --------------------------------------------
# 5 msg/s per vehicleId on veh/+/pos/live. THE BRIDGE DOES NOT ENFORCE THIS — enforcement
# is emqx.conf's `messages_rate = "5/s"`, and a sample dropped here would be one anti-spoof
# never gets to look at. The bridge counts and raises `mqtt.rate_violation` onto
# audit.events, which the broker cannot: EMQX's listener limiter emits no event, and its
# limiter is per CONNECTION while D-17 is written per vehicleId — a device opening two
# sessions under one vehicle credential passes the broker and still breaches the ceiling.
# The bridge sees every live sample exactly once (E-08) across all of a vehicle's
# connections, which makes it the only place the rate D-17 names can be measured.
#
# The window and the one-report-per-cooldown debounce are both Redis keys, for the same
# reason the replay bucket is.
MqttBridge__MonitorPublishRate=true
MqttBridge__PublishCeilingPerSecond=5
MqttBridge__RateViolationCooldown=00:01:00
MqttBridge__RateFlushInterval=00:00:00.500

# How long a stopping replica waits for the forwards it already started, between
# UNSUBSCRIBE and DISCONNECT. This is the whole of "graceful rebalance with no duplicate
# ingest": a payload produced but not acknowledged when the socket closes is one EMQX
# redispatches, and telemetry.raw then carries it twice.
MqttBridge__DrainTimeout=00:00:15

# =====================================================================================
# position-processor-svc — telemetry.raw to the live indexes (R-06, R-17)
# =====================================================================================
PositionProcessor__ConsumerGroup=position-processor-svc

# `veh:seq:{vehicleId}`, layer 1 of the R-17/T-05 replay dedupe. No spec pins the TTL;
# 24 h outlasts any plausible offline stretch and layer 3 (ux_positions_vehicle_seq)
# catches an exact duplicate regardless.
PositionProcessor__SeqWatermarkTtl=1.00:00:00

# The `cell:{h3index}` fan-out buffer. Not a record — Timescale is (T-06) — so it is
# trimmed by length and expired when no vehicle has been in the cell for an hour.
PositionProcessor__CellStreamMaxLength=1000
PositionProcessor__CellStreamTtl=01:00:00

# LEAVE THIS OFF. A processor that woke after ten minutes down and replayed the backlog
# would write every stale sample to geo:live and push it to passengers as current, newest
# last. The live map's recovery path is the next sample from each vehicle, seconds away.
PositionProcessor__StartFromEarliest=false

# --- D-18 / T-07 anti-spoof (C039) ---------------------------------------------------
# Every one of these fails OPEN when switched off, and an open anti-spoof gate looks
# exactly like a working one from the outside: positions flow, the map is populated,
# nothing errors. The service says so once, loudly, at start-up.
PositionProcessor__PlausibilityEnabled=true

# ADD §12.6's per-vehicle-type table, verbatim, in km/h. THE FENCE IS THAT THESE ARE
# CONFIGURATION: an operator retuning a tier after a month of false positives changes a
# setting, not a build. Three of registry's ten types are missing from the ADD table
# (truck, mini_truck, train) and fall to the default — see the C039 handoff.
PositionProcessor__MaxSpeedKph__bus=120
PositionProcessor__MaxSpeedKph__sedan=180
PositionProcessor__MaxSpeedKph__mini_van=140
PositionProcessor__MaxSpeedKph__van=130
PositionProcessor__MaxSpeedKph__flex=200
PositionProcessor__MaxSpeedKph__three_wheeler=80
PositionProcessor__MaxSpeedKph__motorbike=180

# The ceiling for a tier the table above omits — the MOST PERMISSIVE value in it, so a
# type no spec priced is never refused by a number nobody wrote. MaxJumpSpeedKph is
# ADD §12.6's "jump < 1 km/s" and is the backstop those tiers still have.
PositionProcessor__DefaultMaxSpeedKph=200
PositionProcessor__MaxJumpSpeedKph=3600

# D-18: DISCARDED, NOT SMOOTHED. A fix with a 500 m error circle is not a worse position,
# it is a different building; averaging it into a track moves a vehicle somewhere it has
# never been.
PositionProcessor__MaxAccuracyM=200

# An implied speed is a distance over a time, and over a very short time the distance is
# the fix's own error circle rather than motion — 10 m of jitter across 100 ms implies
# 360 km/h. Most trackers also stamp sampleTs to the whole second, so a burst arrives
# with no gap at all. A clamp, not a skip: a teleport published as two same-instant
# samples is still judged at this interval and still fails.
PositionProcessor__MinStepInterval=00:00:01

# T-07, hardware only — a handset's satCount describes one of three fused inputs.
# RequireSatelliteCount is OFF because a GT06 location frame carries no satellite count
# at all, and it is the largest tracker family in mqtt-topics.md §7.
PositionProcessor__MinSatellites=4
PositionProcessor__RequireSatelliteCount=false

# No spec names this. Without it one frame dated 2099 becomes the T-07 monotonic
# watermark and takes that tracker off the map until veh:meta expires.
PositionProcessor__MaxClockSkewAhead=00:05:00

# --- D-17, second line (C039) --------------------------------------------------------
# mqtt-topics.md §4: "10 msg/s per 10 s | position-processor, second line | Drop + flag".
# This is the line that DROPS — EMQX's limiter pauses a connection and mqtt-bridge only
# reports, because a position dropped there is one anti-spoof never gets to look at.
# Averaged over the window rather than per second: D5' §5.2's near-geofence cadence is one
# sample a second and R-07 lets the server ask for bursts on top of it.
PositionProcessor__RateCheckEnabled=true
PositionProcessor__RateCeilingPerSecond=10
PositionProcessor__RateCheckWindow=00:00:10
PositionProcessor__RateViolationCooldown=00:01:00

# --- R-08 candidate index (C039) -----------------------------------------------------
# MUST EQUAL dispatch-svc's Dispatch__PresenceTtl. That service's GPS-freshness gate is
# written against the same number, and the two agreeing is what makes "in the hash" and
# "fresh enough to be offered a ride" the same fact.
PositionProcessor__AvailabilityIndexEnabled=true
PositionProcessor__DriverAvailabilityTtl=00:01:00

# =====================================================================================
# fleet-health-svc — rollups and device-down alerts (T-04, T-10, US-3.13, US-3.16)
# =====================================================================================
# D7' §4.2 gives this service exactly the two variables below. Everything after them is
# C044's and is argued at its declaration in FleetHealthOptions.
#
# US-3.16: "device-down alerts ... when N % of my fleet goes offline within a 5-minute
# window". The comparison is `>=`, not `>`: C044's definition of done is "a simulated
# 10 % fleet outage raises exactly one alert per window", and with a strict comparison a
# fleet configured at 10 that loses exactly 10 % is silent.
#
# WindowMin must equal the `time_bucket` width of telemetry.fleet_health_5m (migration
# 1802), because the alert's numerator IS that aggregate's bucket and its denominator is
# the fleet's ACTIVE tracker roster. Set it to anything else and the percentage is
# computed over two different windows; the service says so loudly at start-up.
Health__OfflinePct=10
Health__WindowMin=5

# --- US-3.13's state ladder ----------------------------------------------------------
# The story's own words: "Online / Stale (no ping > 5 min) / Offline (no ping > 30 min) /
# Decommissioned". Both are returned to the Fleet Portal in the `thresholds` block, so a
# retuned deployment does not need a portal release to relabel its legend.
#
# NOT D6' §4.5's 30 SECONDS — that is dispatch-svc's fallback threshold, a decision about
# one ride taken on the hot path. This is an operator's dashboard, where a bus in a tunnel
# must not read as a device failure.
Health__StaleAfter=00:05:00
Health__OfflineAfter=00:30:00

# --- Ingest ---------------------------------------------------------------------------
# `telemetry.normalized` is the ping clock every state is measured from. Samples are
# collapsed to the newest per vehicle in memory and flushed as one set-based upsert: the
# plane peaks at 20k msg/s (T-10) and "when did this device last ping" changes meaning
# only at the five-minute grain above, so a row write per sample would be four orders of
# magnitude more database work than the question needs.
Health__PingConsumerEnabled=true
Health__ConsumerGroup=fleet-health
Health__FlushInterval=00:00:05
Health__MaxBufferedDevices=200000

# provisioning.events carries the IMEI, the fleet and — the part nothing else can know —
# US-3.8's revocation. Off, a decommissioned tracker reads as merely Offline for ever.
Health__ProvisioningConsumerEnabled=true
Health__ProvisioningConsumerGroup=fleet-health-provisioning

# --- The EMQX device plane (R-15, T-04, US-3.12) --------------------------------------
# OFF by default, the same call trip-state-svc makes for its own last-will worker: this is
# the only part of the service that needs a broker, and a deployment without EMQX
# reachable should serve the dashboard rather than log a connection failure every thirty
# seconds. The four states still work without it — they are thresholds on silence — but a
# dropped session is noticed at StaleAfter rather than immediately, and no battery, signal
# or satellite reading is recorded.
# `acl.conf` already grants `^svc-` the whole `veh/#` and `sys/#` tree, so C044 added no
# ACL rule; MqttServiceName mints `svc-fleet-health`.
Health__DevicePlaneEnabled=false
Health__StatusEnabled=true
Health__DiagnosticsEnabled=true
Health__MqttServiceName=fleet-health

# --- The transition sweep -------------------------------------------------------------
# A device going quiet produces no event, so only a clock can move it Online -> Stale ->
# Offline. Deliberately NOT what the dashboard depends on: the read derives every state
# fresh, so with the sweep off the counts stay correct to the second and only the
# transition metrics, each device's `since` timestamp and the diagnostics sync stop.
Health__SweepEnabled=true
Health__SweepInterval=00:01:00
Health__SweepBatchSize=5000

# prov.tracker_bindings.last_seen_at / signal_strength / battery_mv / sat_count had a
# reader (GET /v1/trackers/{imei}, US-3.12) and no writer until C044 — provisioning-svc's
# own CLAUDE.md hands those four columns to this service. On its own interval because that
# table carries an updated_at trigger: at T-10's 100k trackers a per-sweep sync would be
# 100k real writes a minute for a value C030 already says may be stale.
Health__BindingSyncEnabled=true
Health__BindingSyncInterval=00:05:00

# --- Alerting -------------------------------------------------------------------------
# The tick is not the window: 1802's refresh policy has a five-minute end_offset, so a
# bucket that has just closed may not be materialised yet. Checking every minute means a
# closed window is evaluated at most a minute late, and re-checking is free because
# ux_fleet_health_alert_window has already claimed it.
Health__AlertsEnabled=true
Health__AlertCheckInterval=00:01:00

# Edge-triggered, because US-3.16 says a fleet "goes" offline. Level-triggered, a fleet
# with a fifth of its vehicles parked for the season would alert every window for ever and
# be muted within a day — the same outcome as not alerting, but harder to notice.
Health__AlertOnCrossingOnly=true

# 1 suppresses nothing. On a two-tracker fleet one device is 50 %: correct arithmetic and,
# for some operators, noise. The knob exists so that decision is visible in configuration.
Health__MinFleetSize=1

# Runs telemetry.fleet_health_5m's OWN refresh procedure over the closed window before
# reading it — not a second opinion about the rollup, which is 1802's and TimescaleDB's.
# Off, a just-closed window is still answered correctly by rescanning raw hypertable
# chunks, which is precisely the scan the rollup exists to avoid.
Health__RefreshAggregateEnabled=true

# --- The read -------------------------------------------------------------------------
# GET /v1/fleets/{fleetId}/health returns a flat `items` array (D3' prints no pagination).
# 5 000 is US-3.2's bulk-onboarding ceiling, so the largest fleet the platform lets an
# operator create fits in one answer; beyond it the response sets `itemsTruncated` and the
# counts still cover the whole fleet. Worst states come first, so a truncated list still
# shows what is wrong.
Health__MaxItems=5000

# =====================================================================================
# fanout-svc — SignalR (R-06, D-22, D-23, US-7.16, US-7.17, AL-31, P-13)
# =====================================================================================
# C009's `SignalR__BackplaneRedis` and `Geocell__Res` are both gone, and for opposite
# reasons.
#
# THERE IS NO SIGNALR BACKPLANE, deliberately, and `Fanout__ControlPlaneEnabled` is not
# one. Every replica reads the `cell:{h3index}` streams it has members in and pushes to
# its own local group, so coverage is already complete; `AddStackExchangeRedis()` on top
# would re-broadcast each replica's send to every other replica and a passenger would get
# one copy of every frame per replica in the deployment. D6' §5's backplane earns its
# place only for the DIRECTED sends — ShareRevoked (D-22), RideStateChanged,
# LocationRequestResolved, PackageStatus — whose target connection could be on any
# replica, and C041 carries exactly those on the `fanout:control` Redis channel while
# keeping the per-cell batches off it.
#
# THE RESOLUTION IS NOT A KNOB. R-06 fixes the fan-out grid at res 7 and the 3 km view at
# ring(2) = 19 cells; the KMP module (C012) hard-fails its own build if resolution 8
# appears in its geo package. A client and a server that disagreed would not error — the
# passenger would just see an empty map. It is a constant in MageRide.Shared.Geo.GeoCells.
#
# `signalr-hub.md` §3 puts a VehiclePositions batch at "every 2–8 s". This is the floor of
# that band: the C024 SLO is a position reaching the passenger in under 5 s (p95), so the
# batch window has to be a small fraction of it. It is also the interval at which the
# vehicle and ride streams are drained.
Fanout__BatchInterval=00:00:02
Fanout__MaxEntriesPerCellPerTick=512

# 30 s group-membership hysteresis (ADD §7.4 step 6): a passenger walking along a cell edge
# must not join and leave the same six groups every few seconds.
Fanout__LeaveHysteresis=00:00:30

# Fanout__JoinSeedFrames IS GONE (C042). It replayed each joined cell's tail to the joining
# connection as a stand-in for the snapshot signalr-hub.md §1.1 assigns to GET /v1/nearby;
# that endpoint exists now, and it is the stronger of the two — the seed read only the cells
# the client had joined and only the PUBLIC audience, so it could never show a passenger
# their own engaged vehicle (US-7.16) or their entitled Mode B van (D-23).

# JoinGeocells takes an array off the wire. The 3 km view is 19 cells and the intercity one
# 37; the ceiling is above both so a client crossing a boundary can hold two views during
# the hysteresis window, and low enough that one client cannot put every cell in the
# country on a replica's poll list.
Fanout__MaxCellsPerConnection=128

# --- The visibility model (C041) -----------------------------------------------------
# US-7.17's window, and NO SPEC PINS THE NUMBER. D5' §5.4, ADD §6 and US-7.17 all say
# "older than the freshness window"; the only related figure is ADD §7.5.1's dispatch rule
# (`2 × expectedInterval`), whose interval is per phase and runs from 1 s to 60 s. 60 s
# matches PositionProcessor__DriverAvailabilityTtl and Dispatch__PresenceTtl, so a vehicle
# leaves the passenger's map at the same moment its driver leaves the dispatch pool — two
# different answers would show up as a marker a passenger can see and cannot book.
#
# It cuts twice: a vehicle with no sample inside the window is removed with
# VehicleRemoved{reason:"stale"}, and a frame that ARRIVES older than it is dropped, which
# is what keeps an offline device's replay backlog (veh/{id}/pos/replay, R-17) off the live
# map — those samples travel the same cell stream as live ones.
Fanout__FreshnessWindow=00:01:00

# `share:{userId}` grants plus, for a driver, their own active vehicle (AL-31). A bound on
# what the SERVER reads, not on anything a client may ask for.
Fanout__MaxVehicleSubscriptions=64

# EVERY ONE OF THE NEXT FOUR IS A FILTER THAT CANNOT CLOSE WHEN IT IS OFF, and an open
# filter looks exactly like a working one from the outside: positions flow, the map is
# populated, nothing errors. The service logs a warning naming each at start-up.
#
#   EventsEnabled       ride.events + registry.events. Off ⇒ engaged Mode C vehicles stay
#                       on the public map (US-7.16), Mode B entitlements are never granted
#                       or revoked (D-22/D-23), and no ride may be subscribed to.
#   ControlPlaneEnabled the `fanout:control` Redis channel. Off ⇒ a directed send reaches
#                       only the replica that consumed the event: correct on one replica,
#                       a silent half-delivery on any more.
#   PresenceEnabled     the EMQX veh/+/status subscription. Off ⇒ the freshness window is
#                       the only remaining half of US-7.17 (a minute later, same effect).
Fanout__EventsEnabled=true
Fanout__ControlPlaneEnabled=true
Fanout__PresenceEnabled=true
Fanout__ConsumerGroup=fanout-svc

# How long fanout-svc remembers a ride's participants (SubscribeRide's whole answer) and
# how long an engagement mark survives with no terminal event to clear it. The engagement
# backstop errs long on purpose: a stuck-invisible vehicle costs one driver their bookings,
# and the opposite default would put an engaged taxi back on the public map mid-ride.
Fanout__RideProjectionTtl=1.00:00:00
Fanout__EngagementTtl=12:00:00

# =====================================================================================
# query-svc (C042) — the read side of both planes
#
# Reads only. No Kafka, no outbox, no command log: every route is a GET, and everything this
# service knows it read from state somebody else owns. It writes nothing anywhere.
# =====================================================================================

# --- The live plane (US-7.1, US-7.7, US-7.16, US-7.17) -------------------------------
# MUST EQUAL Fanout__FreshnessWindow. No spec pins either; both match
# PositionProcessor__DriverAvailabilityTtl and Dispatch__PresenceTtl so the map, the
# snapshot and the candidate pool age a vehicle out together. If they drift, a vehicle
# vanishes from the socket and returns on the next poll — a flickering marker to a
# passenger and nothing at all to an operator.
Query__FreshnessWindow=00:01:00

# D3' GET /v1/nearby: radius defaults to 3000 m; the contract's ceiling is 20 000.
Query__DefaultRadiusM=3000
Query__MaxRadiusM=20000

# NO SPEC PINS THIS. `geo:live` has no per-member expiry and nothing removes a member, so a
# GEOSEARCH over a 20 km radius returns every vehicle that has ever driven through it. 500
# is far above what fits on a phone screen at 3 km and far below what makes the read
# expensive; truncation is counted and logged, never silent.
Query__MaxVehicles=500

# EVERY ONE OF THE NEXT THREE IS A DISCLOSURE WHEN IT IS OFF, and an open filter looks
# exactly like a working one from the outside: vehicles appear, positions move, nothing
# errors. The service names each at start-up.
#
#   VisibilityEnabled   the whole D-22/D-23/US-7.16/US-7.17 filter. Off ⇒ every vehicle in
#                       radius goes to every caller: engaged taxis, stale vehicles drawn as
#                       live, and unshared Mode B vehicles disclosed to strangers.
#   EntitlementEnabled  the `share:{userId}` check alone (D-23).
#   OwnRideEnabled      US-7.16's second half. Off ⇒ a passenger on an active hire cannot
#                       see their own vehicle, and driverName/registrationNumber are never
#                       populated (US-7.12). Nothing leaks; the passenger loses their car.
Query__VisibilityEnabled=true
Query__EntitlementEnabled=true
Query__OwnRideEnabled=true

# --- ETA (US-7.11) --------------------------------------------------------------------
# A STRAIGHT LINE WITH A DETOUR FACTOR, AND AN INTERIM. ADD §7.6 puts routing
# (OSRM/Valhalla, snap-to-road) in Phase 3, so there is no road network to measure a path
# against yet. Every number below is a setting precisely because it is a guess that should
# be retuned against observed arrivals — and deleted when the router lands.
#
# EtaSpeedKph are ordinary urban averages INCLUDING STOPS, not ADD §12.6's anti-spoof
# ceilings: those are the speeds above which a fix is a lie, three to five times what a
# vehicle averages across a city.
Query__EtaEnabled=true
Query__EtaDetourFactor=1.3
Query__EtaMinSpeedMps=2.0
Query__DefaultEtaSpeedKph=25
Query__MaxEta=01:30:00
Query__EtaSpeedKph__bus=20
Query__EtaSpeedKph__train=45
Query__EtaSpeedKph__three_wheeler=25
Query__EtaSpeedKph__sedan=28

# --- Geocoding — self-hosted Nominatim (D-14, D-15, D6' §7.6) -------------------------
# NO GOOGLE PLACES, EVER (D3' map hard rule). There is one downstream and no fallback
# provider; a fallback is how "no Google Maps SDK" becomes "except when ours is slow".
#
# Unset ⇒ /v1/geo/search answers from the caller's saved and recent places only (which
# looks like a working search box with a thin index) and /v1/geo/reverse answers 503.
# ADD §6 puts Nominatim on its own 8 GB VPS, never co-located.
Query__NominatimBaseUrl=http://nominatim:8080/
Query__NominatimUserAgent=MageRide-query-svc/1.0 (+https://mageride.lk)
Query__CountryCodes=lk
# The data changes on D-15's WEEKLY osm-pipeline refresh, so a day is an order of magnitude
# inside the interval at which an answer could change.
Query__GeocodeCacheTtl=24:00:00
# 4 decimals ≈ 11 m: finer than consumer GNSS error, coarse enough that a pin dragged across
# a pavement reuses the answer. 5 (≈1 m) would never hit twice.
Query__ReverseCacheDecimals=4
Query__SavedPlaceLimit=5
Query__RecentPlaceLimit=5

# --- Destination options (US-7.15) — delegated, never computed here -------------------
# GTFS route matching is transit-svc's (C061, AL-18) and the Mode C tariff is fare-svc's
# (D5' §1.3). Either computed here would be a second opinion about somebody else's number,
# and the symptom is a price on the options screen that differs from the confirm screen.
# One missing degrades (private tiers alone is C061's own no-feed behaviour); both missing
# is a 503, because an empty options list reads as "there is no way to get there".
Query__TransitBaseUrl=http://app-services:5000/
Query__FareBaseUrl=http://app-services:5000/
Query__PrivateTiers__0=motorbike
Query__PrivateTiers__1=three_wheeler
Query__PrivateTiers__2=flex
Query__PrivateTiers__3=sedan
Query__PrivateTiers__4=mini_van
Query__PrivateTiers__5=van

# --- Read scaling (ADD §9.3) and the internal surface ---------------------------------
# "query-svc reads from replicas with read-after-write consistency only where required."
# Unset ⇒ every read goes to the primary, which is correct outside DOKS and simply not
# scaled. Where read-after-write IS required is decided by the shape of the read, not by a
# caller: the single-trip detail goes to the primary because a passenger opens it seconds
# after ride-svc marked the ride terminal, and replica lag there does not stale the answer,
# it inverts it into a 404 on a trip they have just finished.
# Query__ReplicaConnectionString=Host=postgres-replica;Port=5432;Database=mageride;...

# The interim shared secret query.v1.Query demands as `x-mageride-internal-key`, until the
# Linkerd/SPIFFE mesh lands. UNSET LEAVES THE gRPC SERVICE UNMAPPED — a deployment that
# forgets it gets UNIMPLEMENTED rather than an open read surface over every passenger's
# trip history.
Query__InternalApiKey=change-me-query-internal-key
Query__GrpcEnabled=true

# NOT A PREFERENCE, and D7' §4.2 HAS NO ROW FOR query-svc (C042 micro-change-set). Cleartext HTTP
# has no ALPN, so Kestrel cannot negotiate HTTP/1.1 and HTTP/2 on one socket — a gRPC client's
# preface to the REST port is answered `GOAWAY HTTP_1_1_REQUIRED`. reputation-svc is under the same
# constraint and §4.2 does give it `Grpc__ListenPort`=5005. **5006, not 5005**: both services run in
# the combined app-services container in the dev compose and would fight over the port. 5000 is the
# address gateway-routes.json points the query-svc cluster at; ASPNETCORE_URLS wins if set.
Query__HttpListenPort=5000
Query__GrpcListenPort=5006

# =====================================================================================
# tcp-adapter — hardware tracker ingest (T-01, T-03, T-04, T-05, T-08, T-11, T-12)
#
# Δ C043: this block is now the service's real surface. C009 wrote it before the component
# existed, from D7' §4.2's one-line row. Every knob below is argued at its declaration in
# backend/src/TcpAdapter/Configuration/AdapterOptions.cs.
#
# `Mqtt__ServiceUsername` is gone: it is not in §4.2, it named nothing the service reads,
# and — as the MqttBridge__ServiceName note above warns — an `env_file` is one flat map, so
# a `Mqtt__*` key set here for the adapter reached every container that loads this file. The
# compose `hot-path` service set `Mqtt__ServiceUsername` again in `environment:` purely to
# undo it. `Adapter__ServiceName` replaces it, in both places.
# =====================================================================================

# Listener ports, IN PROTOCOL-FAMILY ORDER: GT06, JT/T 808, H02, generic-NMEA/UDP
# (D6' §4.1's table, which is also 5023-5026 ascending). Positional, and a CSV rather than
# four settings because an env_file is a flat map — `Adapter__Ports__0` is the only way to
# bind an array from one and nobody writing a deployment would guess it.
Adapter__Ports=5023,5024,5025,5026

# D7' §4.2's second tcp-adapter variable, and NOTHING READS IT — kept because §4.2 lists it
# and `infra/scripts/slim-verify.sh` asserts the templates cover §4.2 line for line. The
# `imei:` prefix is `MageRide.Shared.Caching.RedisKeys.Imei`, spelled once for every service
# on the tracker plane: provisioning-svc writes the key, the adapter reads it and
# fleet-health will too, so a configurable prefix is a way for three services to disagree
# about where the cache lives and no way to fix anything. **§4.2 should drop the row**
# (C043 micro-change-set); until it does, changing this value changes nothing.
Provisioning__ImeiCacheKey=imei:

# Bare name; the `svc-` prefix acl.conf grants `veh/#` to is added by the service. Must stay
# `tcp-adapter` unless infra/scripts/slim-verify.sh changes with it — that script asserts
# "svc-tcp-adapter may publish on behalf of a tracker" against the deployed ACL. Set in the
# compose file's `environment:` as well, for the same flat-map reason MqttBridge__ServiceName
# is.
Adapter__ServiceName=tcp-adapter

# ADD §7.7.6's "3 pods x 10k sockets each per protocol family". PER POD and shared across
# the four listeners, not per listener: the constraint is file descriptors and the 512 MB
# D7' §2.1 gives Container 9, and both are per process. A connection past it is accepted and
# closed immediately, so the device's retry reaches another pod rather than waiting here.
Adapter__MaxSockets=10000

# provisioning-svc's internal tracker routes (T-01, T-03). UNSET MEANS EVERY DEVICE WHOSE
# imei:{imei} CACHE ENTRY IS ABSENT IS REFUSED — which is the safe direction (C030: "an
# adapter that cannot reach validate refuses every device") and completely silent from the
# device's side, so the service says it at start-up. The key must equal provisioning-svc's
# own `Provisioning__InternalApiKey`; that service does not map the prefix without it either,
# so a mismatch is a 404 and the same refusal. Base URL is topology and is set in the compose
# file.
Adapter__ProvisioningInternalApiKey=change-me-provisioning-internal-key

# trip-state-svc's AL-32 ignition route. Unset means ACC transitions are decoded and not
# reported, so tracker-equipped Mode A/B vehicles never auto-start or auto-end their sessions
# on ignition (US-3.22/3.23). Must equal trip-state-svc's `TripState__InternalApiKey`.
Adapter__TripStateInternalApiKey=change-me-tripstate-internal-key

# --- T-12: sub-second revocation ------------------------------------------------------
# ADD §7.7.3: the adapter consults the provisioning cache on every connect, "re-validates
# every 5 minutes on long-lived sockets", and "force-closes any matching socket within 1 s"
# on a `prov:tracker` message. The re-validation is the backstop for a pub/sub message that
# was never delivered — a pod restarting when it went out sees nothing on the channel.
Adapter__RevalidateInterval=00:05:00
Adapter__RevocationCloseBudget=00:00:01

# --- T-04: last-will emulation --------------------------------------------------------
# A half-closed socket publishes the retained veh/{vehicleId}/status=offline that trip-state,
# dispatch and fleet-health consume. NO SPEC PINS THE WINDOW: it is a deadline rather than a
# wait — the publish starts as soon as the read loop sees EOF — and past it the session gives
# up and counts it rather than holding its teardown open against a dead broker connection.
# `PublishPresence=false` turns the pair off entirely and is a test-only setting.
Adapter__OfflineWindow=00:00:05
Adapter__PublishPresence=true

# How long a socket may say nothing. NO SPEC PINS IT: a GT06 heartbeats every 3 minutes by
# default and HAProxy's tracker frontends set `timeout client 4h`, so fifteen minutes is five
# missed heartbeats — long enough that a device on a bad cell keeps its session, short enough
# that a half-open socket does not hold a slot in Adapter__MaxSockets for hours.
Adapter__IdleTimeout=00:15:00

# --- T-05: live or backlog ------------------------------------------------------------
# A fix older than this goes to pos/replay instead of pos/live. NO SPEC GIVES A NUMBER, and
# GT06/H02/NMEA carry no "this is buffered" bit, so age is the only signal available; JT/T
# 808 is the exception — its 0x0704 bulk upload IS the backlog and is routed there whatever
# its age. Sixty seconds is above any live cadence D5' §5.2 allows and below the shortest
# coverage gap worth calling one.
Adapter__ReplayAge=00:01:00

# --- T-11: mode routing ---------------------------------------------------------------
# §7.7.7: a Mode C vehicle's tracker publishes only while the driver is online in the app
# (`veh:driver:{vehicleId}`, dispatch-svc's standby binding); Mode A and Mode B publish
# regardless. The vehicle's mode comes from registry.vehicles and is cached for this long.
Adapter__VehicleProfileTtl=00:10:00

# What the gate does for a vehicle whose registry profile cannot be read at all. ON, and the
# direction is argued rather than convenient: closed means a Postgres blip takes every Mode A
# bus off the live map, and §7.7.7 makes the tracker "the authoritative and only source" for
# those — there is no app to fall back to. Open means a Mode C vehicle whose driver is offline
# may appear until the lookup recovers, which position-processor's freshness gate and
# dispatch's own availability check both still see. Set false to invert it.
Adapter__PublishWhenModeUnknown=true

# --- Credentials ----------------------------------------------------------------------
# Refuse a device that presents no credential. OFF, and that is a finding rather than a
# preference: ADD §7.7.3 gives raw-TCP devices a "pre-shared bearer + IMEI signature" and
# THE GT06 LOGIN PACKET HAS NOWHERE TO PUT ONE — eight BCD bytes of terminal id and a model
# code, full stop. H02 and generic-NMEA are the same. JT/T 808's 0x0102 is the only field in
# the four families a credential fits in, so requiring one everywhere refuses three families
# outright. A credential that IS presented is always verified, whatever this is set to.
Adapter__RequireCredential=false

# --- Protocol quirks ------------------------------------------------------------------
# JT/T 808 §8.18 writes the location report's timestamp as BCD YY-MM-DD-hh-mm-ss in BEIJING
# TIME — the standard is a Chinese national one and says so. Set 00:00:00 for a grey import
# re-flashed for another market. Getting it wrong shifts every fix by eight hours, which
# position-processor's clock-skew gate then refuses.
Adapter__Jt808DeviceUtcOffset=08:00:00

# Largest frame buffered before the socket is closed as unsynchronised. A JT/T 808 0x0704
# bulk upload is the biggest legitimate frame and its body length field is ten bits; 8 KiB
# leaves room for that plus a partial second frame.
Adapter__MaxFrameBytes=8192

# --- Sticky-by-IMEI-hash (ADD §7.7.6) --------------------------------------------------
# Four facts live in the pod's memory and none is recoverable from another: the socket a
# downlink writes to, the T-08 duplicate detection, the T-04 presence pair and the JT/T 808
# session state. Stickiness is therefore the L4 balancer's job — HAProxy's stick-table in
# front of 5023-5025, `sessionAffinity: ClientIP` on DOKS. ShardCount>0 turns on the pod's
# own check that the balancer agrees; a device that hashes elsewhere is SERVED ANYWAY and
# logged, because refusing it would turn a misconfiguration into an outage. 0 = off.
Adapter__ShardCount=0
Adapter__Shard=0

# Subscribe veh/+/cmd and translate envelopes into protocol-native command frames (§7.7.5).
Adapter__DownlinkEnabled=true

# =====================================================================================
# api-gateway — D7' §4.2 has NO row for it (C008 gap (d), micro-change-set)
#
# The 21 `ReverseProxy__Clusters__*` destinations are set in the compose file rather than
# here, because they are topology (which container answers) and change between the dev
# stack, the replica and DOKS. Everything else the gateway reads is below.
# =====================================================================================
# Redis for a multi-replica gateway; Memory for a single instance.
Gateway__StateStore=Redis
# Must be HAProxy's address, or X-Forwarded-For is ignored and every caller collapses into
# one rate-limit bucket (C008 handoff).
Gateway__ForwardedHeaders__KnownProxies__0=haproxy

# D-31 minimum-version gate. A client below MinimumVersion gets 426 with
# {updateUrl, latestVersion, isMandatory}; a browser with no X-Platform is not gated.
Gateway__VersionGate__Platforms__android__MinimumVersion=1.0.0
Gateway__VersionGate__Platforms__android__RecommendedVersion=1.0.0
Gateway__VersionGate__Platforms__android__LatestVersion=1.0.0
Gateway__VersionGate__Platforms__android__UpdateUrl=https://play.google.com/store/apps/details?id=lk.mageride.driver
Gateway__VersionGate__Platforms__ios__MinimumVersion=1.0.0
Gateway__VersionGate__Platforms__ios__RecommendedVersion=1.0.0
Gateway__VersionGate__Platforms__ios__LatestVersion=1.0.0
Gateway__VersionGate__Platforms__ios__UpdateUrl=https://apps.apple.com/lk/app/mageride-driver/id0000000000

# D-30 attestation: Disabled | Audit | Enforce. Disabled in dev — neither app exists until
# Wave 4a/4b, and Enforce with no client rejects every request to the 22 sensitive
# operations. C125 sets Audit, then Enforce per platform as each app ships.
Gateway__Attestation__Mode=Disabled
Gateway__Attestation__PlayIntegrity__PackageName=lk.mageride.driver
Gateway__Attestation__PlayIntegrity__ServiceAccountJson=CHANGEME_play_integrity_service_account_json
Gateway__Attestation__AppAttest__AppId=CHANGEME_TEAMID.lk.mageride.driver
