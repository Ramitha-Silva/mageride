# =====================================================================================
# .env.app — D7' §4.2 per-service additions (C009)
#
# Loaded after .env.common by `app-services`, `hot-path`, `fanout`, `tcp-adapter` and
# `api-gateway`. Copy to `infra/env/.env.app` (gitignored) to override locally.
#
# D7' §3 gives only `app-services` this file, but §4.2 has rows for position-processor,
# persistence-writer, mqtt-bridge and fleet-health (the four services inside `hot-path`),
# for fanout-svc and for tcp-adapter. Those variables have to reach the process that reads
# them, so all four containers load it. **Micro-change-set for D7' §3.**
#
# Since the replica co-locates 21 domain services in one process, the keys below are a
# single flat namespace — `Onepay__ApiKey` is read by both fare-svc and wallet-svc, and
# `Otp__*` is iam-svc's OTP policy while ride-svc's pickup OTP pepper is
# `Otp__PepperKey`. When production splits the services into separate pods each gets only
# its own rows, and the collisions disappear.
#
# Secrets are `CHANGEME_*` placeholders. Every one of them is marked **yes** in the D7'
# §4.2 Secret column and is sourced from Vault in the replica and in production (D7' §13).
# =====================================================================================

# =====================================================================================
# iam-svc — auth (D-29, D-32, AL-07, AL-37)
# =====================================================================================
# Notify.lk is the primary SMS gateway (D6' §7.3). Set `Sms__Provider=notifylk` to use it —
# it then needs both credentials below or iam-svc refuses to start, because a service that
# boots healthy and delivers no OTP is a service nobody can sign in to. Left unset here so a
# copied-and-not-yet-filled-in file still starts: the default is the dev sender, which logs
# the code instead of sending it and is itself refused outside Development.
# Sms__Provider=notifylk
Sms__NotifyLkUserId=CHANGEME_notify_lk_user_id
Sms__NotifyLkApiKey=CHANGEME_notify_lk_api_key
Sms__NotifyLkSenderId=MageRide
# RS256 private key, PEM. Rotated every 90 days with a JWKS overlap (D7' §13): the outgoing
# key moves to Jwt__RetiredSigningKeyPems__0 for one deploy, so tokens signed by it keep
# validating, and is deleted in the deploy after that.
Jwt__SigningKeyPem=CHANGEME_rs256_private_key_pem
Jwt__RetiredSigningKeyPems__0=
# Not in D7' §4.2 — C026 micro-change-set. Without it the refresh HMAC is derived from the
# signing key, so the 90-day rotation above logs every user out.
Jwt__RefreshTokenKey=CHANGEME_refresh_token_hmac_key
Otp__ResendCooldownSec=60
Otp__MaxPerHour=5
# Admin Portal (password/Google) and Fleet Portal (email/Google/Apple). The mobile apps
# are Phone-OTP only (AL-07), so these are optional — but an EMPTY client-id list refuses
# every provider token rather than accepting all of them, which is deliberate: validating
# without an audience would accept an ID token minted for anybody else's OAuth client.
# **These four keys replace the `Google__ClientId` / `Apple__ClientId` pair this file used
# to carry** — neither matched anything the service binds. C026 micro-change-set.
Oidc__Google__ClientIds__0=
Oidc__Google__ClientSecret=
Oidc__Google__RedirectUri=https://admin.mageride.lk/auth/callback
Oidc__Apple__ClientIds__0=
# AL-37's compensating controls, enforced in iam-svc's own handlers (not in admin-bff).
# The allow-list is OFF while empty; add CIDRs to turn it on for the six internal roles.
Auth__MaxFailedAttempts=5
Auth__LockoutDuration=00:15:00
Auth__InternalRoleIpAllowList__0=
# C027, not in D7' §4.2. HMAC key for `iam.phone_lookups.phone_hash` (P-03) — REQUIRED outside
# Development, because an unkeyed digest of a `+947XXXXXXXX` number is a 10^8 offline search and
# so not a hash of anything. **Not rotatable in place**: every existing digest is keyed with the
# old value, so a new key partitions the table rather than re-keying it. Deliberately not
# `Otp__PepperKey`, which guards a five-minute code and is rotated freely.
Auth__PhoneHashKey=CHANGEME_iam_phone_lookup_hmac_key
# C027, not in D7' §4.2. Guards GET /v1/users/lookup — the P-03 registration oracle ride-svc
# calls to decide between an in-app FCM location request and the SMS pickup-confirm path. The
# route is NOT under the /v1/internal/** prefix the gateway refuses (C008) and the `iam-users`
# gateway route forwards it from the public internet, so the service authenticates it itself
# until C042 lands a mesh. UNSET means the route is not mapped at all — a deployment that forgets
# it gets 404s and a broken proxy booking, not an open door.
Auth__InternalApiKey=CHANGEME_iam_internal_service_key
# `Mfa__IssuerName` and `Mfa__RequiredForInternal` are deliberately ABSENT. AL-37 removed
# the second factor for internal roles; D3' §0 and D7' §4.2's admin-bff row still describe
# it, and planner finding 3 resolves that in AL-37's favour. The compensating controls are
# the two keys directly above, plus the session binding the `device_id` claim gives.

# =====================================================================================
# registry-svc — registration + OnePay merchant binding (D-11)
# =====================================================================================
Ocr__Endpoint=http://app-services:5000/v1/internal/ocr
Onepay__MerchantOnboardingUrl=https://merchant.onepay.lk/onboarding
# C021, not in D7' §4.2. Maps POST /v1/dev/vehicles/{id}/approve, which flips a vehicle to
# APPROVED **without** AL-10's mandatory insurance document or the AL-30 onboarding steps.
# Unset = Development only. The lightweight production replica runs synthetic data under the
# Production environment name and needs it; a real deployment must leave it unset or false.
Registry__DevApprovalEnabled=true

# =====================================================================================
# provisioning-svc — device PKI (T-02)
# =====================================================================================
StepCa__Url=https://127.0.0.1:9000
StepCa__RootKeyPath=/var/step
Cred__RotationDays=90

# =====================================================================================
# query-svc — map data (D-14)
# =====================================================================================
Tiles__BaseUrl=https://tiles.mageride.lk
# The replica hosts Nominatim on a SEPARATE VPS — 8 GB is a third of this box's budget
# (lightweight-production-replica.md). Empty here means geocoding is unavailable in dev.
Nominatim__Url=

# =====================================================================================
# trip-state-svc — Mode A/B sessions (D-03)
# =====================================================================================
Session__IdleTimeoutMin=30
Geofence__AutoEndM=100

# =====================================================================================
# ride-svc — the Mode C ride aggregate (R-01, P-07, E-09)
# =====================================================================================
# HMAC pepper for the pickup/delivery OTP (P-07). Never the same value as any JWT key.
Otp__PepperKey=CHANGEME_ride_otp_hmac_pepper
Quartz__SchedulerName=mageride-ride
Outbox__Channel=ride_outbox
Outbox__Schema=rides
Outbox__Topic=ride.events
# C022, not in D7' §4.2. Guards /v1/internal/rides/** — the two moves dispatch-svc drives
# (Requested -> Matching -> Offered). D3' §0 puts the whole internal family on service-to-service
# mTLS and the gateway already refuses the prefix at the edge (C008), but no mesh exists until
# C042, so the in-cluster hop carries a shared secret. UNSET means the routes are not mapped at
# all — dispatch-svc then places no offers and no driver is ever asked.
Ride__InternalApiKey=CHANGEME_ride_internal_api_key
# D5' §3.5's 15 s offer window, used when dispatch-svc sends no ttlSeconds. ride-svc's clock
# stamps offer_expires_at, because it is ride-svc's `offer_expires_at > now()` that decides an
# accept (ADD §11.11).
Ride__OfferTtl=00:00:15

# =====================================================================================
# dispatch-svc — matching, job board, directional (D-06, D-08, R-04)
# =====================================================================================
# D5' §3.5 / US-6A.3. What dispatch ASKS for; ride-svc stamps the actual deadline from its own
# clock, because it is ride-svc's `offer_expires_at > now()` that decides an accept (ADD §11.11).
Dispatch__OfferTtl=00:00:15
# C023, not in D7' §4.2. The exact-distance post-filter's radius (D5' §3.1's `searchRadius`,
# which no spec gives a value for — recorded as a gap in the C023 handoff). The H3 res-5 ring(2)
# pre-filter reaches ~40 km and is NEVER a distance bound (R-06); this is what decides.
Dispatch__SearchRadiusM=5000
Dispatch__H3Resolution=5
Dispatch__H3RingK=2
# Bounds the D5' §3.5 cascade. The US-6A.11 120 s ExpiredNoDriver timeout is C034's — no route
# exists to write that ride state yet, so this is what stops the loop.
Dispatch__MaxOfferRounds=8
# Must equal ride-svc's Ride__InternalApiKey, or every offer is answered 404 and no driver is
# ever asked — which from the outside looks exactly like "nobody is online".
Dispatch__RideServiceBaseUrl=http://dispatch-needs-ride-svc:8080
Dispatch__RideServiceInternalKey=CHANGEME_ride_internal_api_key
Dispatch__GlobalTimeoutSec=120
JobBoard__RadiusKm=30
Wallet__CacheTtlSec=5
# dispatch.outbox does not appear in either DDL source; C004 created it because D6' §2.4
# names dispatch-svc as an outbox writer and offer.created is the event R-13 exists for.
#
# The `Dispatch__` prefix is deliberate and these three bind NOTHING (C023). This file is one
# flat namespace shared by every co-located service — see the header — and ride-svc's
# `Outbox__Channel=ride_outbox` is 20 lines above; an unprefixed key here would silently point
# ride-svc's dispatcher at the dispatch channel. `DispatchApplication` sets exactly these three
# as its own defaults in code instead, so the service is correct with or without them, and they
# stay here as the documented per-service values for the day production splits the pods.
Dispatch__Outbox__Channel=dispatch_outbox
Dispatch__Outbox__Schema=dispatch
Dispatch__Outbox__Topic=dispatch.events

# =====================================================================================
# fare-svc — payment (D-10)
# =====================================================================================
# C022, not in D7' §4.2. HMAC key behind `fareEstimateToken`: fare-svc signs a quote with it and
# ride-svc verifies it, so BOTH services must be given the same value or every booking is a
# 400 invalid-fare-token. There is deliberately no default — a token signed with a well-known
# key is one a client can mint for itself, and naming your own fare is exactly what the token
# exists to stop.
Fare__EstimateTokenKey=CHANGEME_fare_estimate_token_hmac_key
# How long a quote stays bindable. No spec fixes it; 15 minutes is long enough to compare tiers
# and short enough that a peak window cannot open underneath the price (D5' §1.1).
Fare__EstimateTokenTtl=00:15:00
Onepay__ApiKey=CHANGEME_onepay_api_key
Onepay__WebhookSecret=CHANGEME_onepay_webhook_secret
LankaQr__MerchantId=CHANGEME_lankaqr_merchant_id

# =====================================================================================
# subscription-svc — daily fee (D-13)
# =====================================================================================
Fee__FirstTripFree=true
Tz=Asia/Colombo

# =====================================================================================
# wallet-svc — driver wallet (D-12, AL-05)
# =====================================================================================
LowBalance__ThresholdMinor=20000
# `ComBankIpg__WebhookSecret` is listed by D7' §4.2 but AL-05 withdrew bank-transfer
# top-ups entirely — D7' §9 itself says "no bank-transfer IPG, AL-05", C007 landed no
# /v1/wallet/topup/bank-transfer operation, and no service reads this key. Listed so the
# template covers every §4.2 row; left empty because nothing consumes it.
# **Micro-change-set: D7' §4.2's wallet-svc row should drop it.**
ComBankIpg__WebhookSecret=

# =====================================================================================
# notification-svc — push + SMS (E-01, D-33)
# =====================================================================================
Fcm__ServiceAccountJson=CHANGEME_fcm_service_account_json
Apns__P8Key=CHANGEME_apns_p8_key
Apns__KeyId=CHANGEME_apns_key_id
Apns__TeamId=CHANGEME_apns_team_id
# Second SMS gateway (Dialog/Mobitel) — D-33 requires a dual path for SOS. This file is one
# flat map read by every service, so iam-svc reads the same key: it is the OTP fallback when
# Notify.lk refuses or is unreachable (D6' §7.3). SOS sends through both in parallel;
# an OTP tries the primary first and only falls through on failure.
Sms__SecondaryGateway=
Sms__SecondaryApiKey=
Sms__SecondarySenderId=

# =====================================================================================
# safety-svc — SOS + trip share (D-33, D-34)
# =====================================================================================
Sos__SloMs=5000
TripShare__TtlGraceMin=60

# =====================================================================================
# reputation-svc — block_status / level over gRPC
# =====================================================================================
Grpc__ListenPort=5005

# =====================================================================================
# content-svc — Si/Ta/En templates (D-26)
# =====================================================================================
Cache__Ttl=300

# =====================================================================================
# support-svc — tickets
# =====================================================================================
# Storage__ScreenshotBucket is in .env.common with the other three buckets, since the
# endpoint and credentials it needs are platform-wide and D7' §4 defines neither.

# =====================================================================================
# fleet-svc — Phase 1 (AL-03)
# =====================================================================================
Fleet__RlsEnabled=true
Fleet__VerificationGate=true

# =====================================================================================
# admin-bff — Admin Portal, nine-role RBAC (AL-02, AL-06, D-35, E-06)
# =====================================================================================
Audit__Topic=audit.events
Pdpa__DueDays=30
Rbac__DenyByDefault=true
Login__MaxFailedAttempts=5
Login__LockoutMinutes=15
# Optional CSV of CIDRs. Empty = no IP restriction. With AL-37 removing MFA this and the
# lock-out above are the compensating controls for internal sign-in.
Login__IpAllowList=

# =====================================================================================
# ocr-svc — document OCR + Mode-C auto-verify (D-36)
# =====================================================================================
Gemini__ApiKey=CHANGEME_gemini_api_key
Gemini__Model=gemini-flash-3.0
Redaction__Enabled=true

# =====================================================================================
# voip-svc — free in-app voice (D-24, AL-48)
# =====================================================================================
# Optional in D7' §4.2: the `voip` container is optional and voip-svc returns
# "VoIP unavailable" when LiveKit is unreachable. No masked calling and no DID lease —
# AL-48 withdrew number masking; the fallback is a plain tel: link (D-25).
LiveKit__ApiKey=
LiveKit__Secret=
Turn__Realm=mageride.lk

# =====================================================================================
# position-processor-svc — hot path (D-18, T-05)
# =====================================================================================
Plausibility__MaxAccuracyM=200
Replay__MaxPerSec=20

# =====================================================================================
# persistence-writer-svc — hot path (T-06)
# =====================================================================================
Timescale__BatchRows=1000
Timescale__FlushMs=500

# =====================================================================================
# mqtt-bridge-svc — EMQX to Redpanda (E-08)
# =====================================================================================
# C024 replaced C009's `Emqx__SharedSub` / `Emqx__ReplaySharedSub` with the GROUP NAMES.
# The service builds `$share/{group}/veh/+/pos/live` itself (MqttTopics.SharedPositionLive),
# which removes two ways to break E-08 silently: a filter that lost its `$share/` prefix
# makes every replica receive every message — `telemetry.raw` then carries one copy per
# replica and nothing errors — and a filter pointed at the wrong topic subscribes
# successfully to nothing. It also removes the `$$` escaping this block used to need:
# docker compose interpolates env_file values, and a literal `$share` expanded to the
# empty string with a "variable is not set" warning.
#
# Note the group names: the replay group is `posReplayGroup`, not C009's `replayGroup`.
# Any name works as long as every replica agrees, but live and replay must NOT share one —
# R-09 keeps a reconnect storm's backlog off the live path.
MqttBridge__LiveShareGroup=posGroup
MqttBridge__ReplayShareGroup=posReplayGroup

# Without the `svc-` prefix acl.conf grants nothing: `$share/#` and the `veh/#` wildcard
# are the `svc-` principal's alone. The service adds the prefix, so this is the bare name.
#
# It is `MqttBridge__ServiceName`, not the `Mqtt__ServiceUsername` C009 used here, and that
# is not only cosmetic: env_file entries are one flat map, so the `Mqtt__ServiceUsername`
# in the tcp-adapter block below would otherwise win for every container that reads this
# file — the compose `hot-path` service sets it again in `environment:` purely to undo that.
MqttBridge__ServiceName=mqtt-bridge

# Consume the backlog stream as well as the live one. A topic nobody consumes is a
# vehicle whose offline history is silently lost.
MqttBridge__ConsumeReplay=true

# =====================================================================================
# position-processor-svc — telemetry.raw to the live indexes (R-06, R-17)
# =====================================================================================
PositionProcessor__ConsumerGroup=position-processor-svc

# `veh:seq:{vehicleId}`, layer 1 of the R-17/T-05 replay dedupe. No spec pins the TTL;
# 24 h outlasts any plausible offline stretch and layer 3 (ux_positions_vehicle_seq)
# catches an exact duplicate regardless.
PositionProcessor__SeqWatermarkTtl=1.00:00:00

# The `cell:{h3index}` fan-out buffer. Not a record — Timescale is (T-06) — so it is
# trimmed by length and expired when no vehicle has been in the cell for an hour.
PositionProcessor__CellStreamMaxLength=1000
PositionProcessor__CellStreamTtl=01:00:00

# LEAVE THIS OFF. A processor that woke after ten minutes down and replayed the backlog
# would write every stale sample to geo:live and push it to passengers as current, newest
# last. The live map's recovery path is the next sample from each vehicle, seconds away.
PositionProcessor__StartFromEarliest=false

# =====================================================================================
# fleet-health-svc — rollups (T-01)
# =====================================================================================
Health__OfflinePct=10
Health__WindowMin=5

# =====================================================================================
# fanout-svc — SignalR (R-06)
# =====================================================================================
# C009's `SignalR__BackplaneRedis` and `Geocell__Res` are both gone, and for opposite
# reasons.
#
# THERE IS NO BACKPLANE, deliberately. Every replica reads the `cell:{h3index}` streams it
# has members in and pushes to its own local group, so coverage is already complete; a
# Redis backplane on top would re-broadcast each replica's send to every other replica and
# a passenger would get one copy of every frame per replica in the deployment. D6' §5
# offers a backplane for the DIRECTED sends — ShareRevoked (D-22), RideStateChanged,
# DriverPosition — which is C041's work. C041 adds it back for those and must not put the
# per-cell batches through it.
#
# THE RESOLUTION IS NOT A KNOB. R-06 fixes the fan-out grid at res 7 and the 3 km view at
# ring(2) = 19 cells; the KMP module (C012) hard-fails its own build if resolution 8
# appears in its geo package. A client and a server that disagreed would not error — the
# passenger would just see an empty map. It is a constant in MageRide.Shared.Geo.GeoCells.
#
# `signalr-hub.md` §3 puts a VehiclePositions batch at "every 2–8 s". This is the floor of
# that band: the C024 SLO is a position reaching the passenger in under 5 s (p95), so the
# batch window has to be a small fraction of it. C041 makes it adaptive.
Fanout__BatchInterval=00:00:02
Fanout__MaxEntriesPerCellPerTick=512

# 30 s group-membership hysteresis (ADD §7.4 step 6): a passenger walking along a cell edge
# must not join and leave the same six groups every few seconds.
Fanout__LeaveHysteresis=00:00:30

# A bounded stand-in for query-svc's GET /v1/nearby (C042), which signalr-hub.md §1.1 makes
# the real snapshot path. Until it exists a passenger who opens the map sees nothing at all
# until each nearby vehicle's next sample. Sent to the joining connection only.
# C041/C042 SHOULD REMOVE THIS once /v1/nearby lands — two snapshot paths is one more than
# the contract has.
Fanout__JoinSeedFrames=32

# JoinGeocells takes an array off the wire. The 3 km view is 19 cells and the intercity one
# 37; the ceiling is above both so a client crossing a boundary can hold two views during
# the hysteresis window, and low enough that one client cannot put every cell in the
# country on a replica's poll list.
Fanout__MaxCellsPerConnection=128

# =====================================================================================
# tcp-adapter — hardware tracker ingest (T-01, T-03)
# =====================================================================================
Adapter__Ports=5023,5024,5025,5026
Provisioning__ImeiCacheKey=imei:
Mqtt__ServiceUsername=svc-tcp-adapter

# =====================================================================================
# api-gateway — D7' §4.2 has NO row for it (C008 gap (d), micro-change-set)
#
# The 21 `ReverseProxy__Clusters__*` destinations are set in the compose file rather than
# here, because they are topology (which container answers) and change between the dev
# stack, the replica and DOKS. Everything else the gateway reads is below.
# =====================================================================================
# Redis for a multi-replica gateway; Memory for a single instance.
Gateway__StateStore=Redis
# Must be HAProxy's address, or X-Forwarded-For is ignored and every caller collapses into
# one rate-limit bucket (C008 handoff).
Gateway__ForwardedHeaders__KnownProxies__0=haproxy

# D-31 minimum-version gate. A client below MinimumVersion gets 426 with
# {updateUrl, latestVersion, isMandatory}; a browser with no X-Platform is not gated.
Gateway__VersionGate__Platforms__android__MinimumVersion=1.0.0
Gateway__VersionGate__Platforms__android__RecommendedVersion=1.0.0
Gateway__VersionGate__Platforms__android__LatestVersion=1.0.0
Gateway__VersionGate__Platforms__android__UpdateUrl=https://play.google.com/store/apps/details?id=lk.mageride.driver
Gateway__VersionGate__Platforms__ios__MinimumVersion=1.0.0
Gateway__VersionGate__Platforms__ios__RecommendedVersion=1.0.0
Gateway__VersionGate__Platforms__ios__LatestVersion=1.0.0
Gateway__VersionGate__Platforms__ios__UpdateUrl=https://apps.apple.com/lk/app/mageride-driver/id0000000000

# D-30 attestation: Disabled | Audit | Enforce. Disabled in dev — neither app exists until
# Wave 4a/4b, and Enforce with no client rejects every request to the 22 sensitive
# operations. C125 sets Audit, then Enforce per platform as each app ships.
Gateway__Attestation__Mode=Disabled
Gateway__Attestation__PlayIntegrity__PackageName=lk.mageride.driver
Gateway__Attestation__PlayIntegrity__ServiceAccountJson=CHANGEME_play_integrity_service_account_json
Gateway__Attestation__AppAttest__AppId=CHANGEME_TEAMID.lk.mageride.driver
