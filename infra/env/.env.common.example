# =====================================================================================
# .env.common — D7' §4.1, every .NET service (C009)
#
# This committed `.example` file is loaded as the FIRST env_file of every service in both
# dev compose files, so a clean checkout comes up with working defaults and no setup step.
# Copy it to `infra/env/.env.common` (gitignored) to override anything locally — compose
# loads that second, and later values win. Nothing creates that file for you on purpose:
# a copy made once would shadow every later edit to this one.
#
# Values here are dev-only and must never carry a real credential (infra/CLAUDE.md).
# Anything a real deployment has to supply is spelled `CHANGEME_*`, so a service that
# actually needs it fails loudly at start-up rather than half-working.
#
# NOTE: docker compose does NOT interpolate env_file contents — `$`, `#` inside a value
# and quotes are all literal. Do not `source` this file in bash; `$share/...` below would
# expand to nothing.
# =====================================================================================

# --- Runtime -------------------------------------------------------------------------
# D7' §4.1 defaults this to Production. Development turns on developer exception pages and
# relaxes the kernel's config validation, which is what a dev compose wants.
ASPNETCORE_ENVIRONMENT=Development
DOTNET_gcServer=1

# --- PostgreSQL ----------------------------------------------------------------------
# D7' §4.1: `ConnectionStrings__Postgres` is the PgBouncer DSN. PgBouncer runs in
# transaction mode (server_db_schema.md §0, ADD §9.3), so every service reaches Postgres
# through :6432 and never :5432.
ConnectionStrings__Postgres=Host=pgbouncer;Port=6432;Database=mageride;Username=mageride;Password=mageride_dev;Pooling=true;Maximum Pool Size=20

# NOT in D7' §4.1 — micro-change-set raised by C002.
# LISTEN is session-scoped, and transaction pooling returns the server connection at
# COMMIT, so a LISTEN registered through PgBouncer is dropped and the E-09 outbox
# dispatcher never wakes: the sub-50 ms path silently degrades to the 250 ms poll it was
# meant to replace. ride-svc and dispatch-svc require this; everything else may omit it
# and MageRide.Shared falls back to the pooled DSN with a warning.
ConnectionStrings__PostgresDirect=Host=postgres;Port=5432;Database=mageride;Username=mageride;Password=mageride_dev;Pooling=true;Maximum Pool Size=5

# --- Redis ---------------------------------------------------------------------------
# D7' §4.1 documents this as `redis://redis:6379`; StackExchange.Redis (C002) parses its
# own configuration-string form, not a URI scheme.
ConnectionStrings__Redis=redis:6379

# --- Redpanda (Kafka API) ------------------------------------------------------------
Kafka__BootstrapServers=redpanda:9092

# --- Auth ----------------------------------------------------------------------------
# iam-svc's JWKS endpoint (C026). Every service validates RS256 access tokens against it;
# the API gateway deliberately does not (C008 decision 2).
Jwt__JwksUrl=http://app-services:5000/v1/internal/iam/.well-known/jwks.json

# --- Telemetry -----------------------------------------------------------------------
# D7' §4.1 marks this optional. Empty = exporters disabled; the dev stack ships no
# collector (the `monitoring` container is C119/C125). Point it at http://otel:4317 when
# one is running.
Otel__Endpoint=
Otel__ServiceNamespace=mageride
Otel__PrometheusEnabled=true

# --- Region --------------------------------------------------------------------------
# D-38: every business date is computed in Asia/Colombo, never in UTC and never in the
# host's zone.
Region__Timezone=Asia/Colombo
TZ=Asia/Colombo

# =====================================================================================
# Below this line: platform-wide settings that D7' §4 does not define but that the dev
# stack cannot run without. Each is a micro-change-set candidate for D7' §4.1 — see the
# C009 handoff in build/progress.md.
# =====================================================================================

# --- MQTT (EMQX) ---------------------------------------------------------------------
# D7' §4.2 gives mqtt-bridge-svc an `Emqx__SharedSub` but no broker address, and nothing
# anywhere names the broker for tcp-adapter or provisioning-svc. In-cluster components use
# the plaintext 1883 listener, which is never published outside the docker network.
Mqtt__BrokerUrl=mqtt://emqx:1883
Mqtt__ClientIdPrefix=mageride-dev

# The dev broker authenticates with a shared HMAC secret so the stack stands up before
# provisioning-svc (C030) exists to mint RS256 session tokens. The value must match
# MQTT_JWT_SECRET in the compose file, which passes it to EMQX as
# EMQX_AUTHENTICATION__1__SECRET. The replica and production use JWKS instead (D-21) —
# see the commented block in infra/deploy/emqx/emqx.conf.
Mqtt__DevJwtSecret=mageride-dev-mqtt-jwt-secret-change-me

# --- Object storage (MinIO / S3) -----------------------------------------------------
# D7' §4.2 names `Storage__ScreenshotBucket` for support-svc but no spec defines an
# endpoint, credentials or the other three buckets, even though the replica's Container 10
# lists all four uses. Production points these at Cloudflare R2 (D7' §8).
Storage__S3__Endpoint=http://minio:9000
Storage__S3__Region=us-east-1
Storage__S3__AccessKey=mageride_dev
Storage__S3__SecretKey=mageride_dev_secret
Storage__S3__ForcePathStyle=true
Storage__DocumentsBucket=mageride-documents
Storage__ProofsBucket=mageride-proofs
Storage__ProfileBucket=mageride-profile
Storage__ScreenshotBucket=mageride-screenshots

# --- Idempotency / outbox (C002 kernel defaults, shown so they are discoverable) ------
# `Json` keeps the response body byte-for-byte, which is what R-14 replay and ADD §11.13
# require; `Jsonb` reorders keys and `Bytea` is opaque to SQL. C004 landed
# rides.command_log.response_body as `json` to match.
CommandLog__BodyStorage=Json
Idempotency__ReservationTimeoutSec=60
