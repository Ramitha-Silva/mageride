{
  "uid": "mageride-postgres",
  "title": "MageRide — PostgreSQL (system of record)",
  "description": "ADD §13.2's Postgres row: TPS, replication lag, long-running queries, vacuum lag, connection pool saturation. Scraped from the primary directly and never through PgBouncer — pg_stat_* is per backend, and a transaction-pooled connection reports whichever server connection the pooler happened to hand over.",
  "tags": ["mageride", "postgres", "add-13.2"],
  "timezone": "Asia/Colombo",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "pg_up", "instant": true }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Transactions/s",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"mageride\"}[5m]) + rate(pg_stat_database_xact_rollback{datname=\"mageride\"}[5m]))", "instant": true }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connections used",
      "description": "ADD §13.2's 'connection pool saturation'. Every service reaches Postgres through PgBouncer in transaction mode (M-5, ADD §9.3), so a high number with the pooler in front means either a pool sized past the server or sessions not being returned — the E-09 outbox LISTEN holds one per replica by design.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.85 }, { "color": "red", "value": 0.95 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(pg_stat_activity_count) / clamp_min(max(pg_settings_max_connections), 1)", "instant": true }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Longest transaction",
      "description": "A transaction open for minutes holds back vacuum across every table it touched, so this and the vacuum-lag panel usually move together.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 300 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "max(pg_stat_activity_max_tx_duration)", "instant": true }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Replication lag",
      "description": "ADD §13.4 pages above 30 s. Zero on the single-Postgres MVP — pg_replication_lag_seconds only means anything on a standby, hence the pg_replication_is_replica guard in the alert.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 30 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "max(pg_replication_lag_seconds)", "instant": true }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Deadlocks (last hour)",
      "description": "The atomic accept is one conditional UPDATE with no advisory lock and no application-side ordering (ADD §11.11), so a deadlock here means a code path that took two locks in two orders.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(increase(pg_stat_database_deadlocks{datname=\"mageride\"}[1h]))", "instant": true }]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Transactions and tuple work",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"mageride\"}[$__rate_interval]))", "legendFormat": "commits/s" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_xact_rollback{datname=\"mageride\"}[$__rate_interval]))", "legendFormat": "rollbacks/s" },
        { "refId": "C", "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"mageride\"}[$__rate_interval]))", "legendFormat": "rows inserted/s" },
        { "refId": "D", "expr": "sum(rate(pg_stat_database_tup_updated{datname=\"mageride\"}[$__rate_interval]))", "legendFormat": "rows updated/s" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Connections by state",
      "description": "`idle in transaction` is the dangerous one: it holds locks and blocks vacuum while doing no work. A rising count is usually a service that opened a transaction and then made a network call inside it.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (state) (pg_stat_activity_count{datname=\"mageride\"})", "legendFormat": "{{state}}" },
        { "refId": "B", "expr": "max(pg_settings_max_connections)", "legendFormat": "max_connections" }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Cache hit ratio and I/O",
      "description": "A hit ratio falling away from 1 on a working set that has not grown is usually the hypertable's newest chunks pushing everything else out of shared_buffers.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "custom": { "lineWidth": 1, "fillOpacity": 0, "showPoints": "never" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": ".*blocks/s" }, "properties": [{ "id": "unit", "value": "cps" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "max", "value": null }] }] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"mageride\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=\"mageride\"}[$__rate_interval]) + rate(pg_stat_database_blks_read{datname=\"mageride\"}[$__rate_interval])), 1e-9)", "legendFormat": "cache hit ratio" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_blks_read{datname=\"mageride\"}[$__rate_interval]))", "legendFormat": "read from disk blocks/s" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Vacuum lag — dead tuples awaiting collection",
      "description": "ADD §13.2's 'vacuum lag'. `rides.rides` and `dispatch.driver_presence` are the two tables that churn hardest; dead tuples accumulating on either is autovacuum being outrun or blocked by a long transaction.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "topk(10, pg_stat_user_tables_n_dead_tup)", "legendFormat": "{{schemaname}}.{{relname}}" },
        { "refId": "B", "expr": "max(pg_stat_activity_max_tx_duration)", "legendFormat": "longest transaction (s)" }
      ]
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Database size and locks",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "lock.*" }, "properties": [{ "id": "unit", "value": "short" }, { "id": "custom.axisPlacement", "value": "right" }] }] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "pg_database_size_bytes{datname=\"mageride\"}", "legendFormat": "database size" },
        { "refId": "B", "expr": "sum by (mode) (pg_locks_count{datname=\"mageride\"})", "legendFormat": "locks · {{mode}}" }
      ]
    }
  ]
}
