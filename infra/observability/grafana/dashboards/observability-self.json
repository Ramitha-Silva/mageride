{
  "uid": "mageride-observability-self",
  "title": "MageRide — Observability stack (self)",
  "description": "The stack watching itself. Everything on every other board is silent if this one is broken, and a silent alerting pipeline reads as a healthy platform — which is the worst failure mode observability has.",
  "tags": ["mageride", "observability", "meta"],
  "timezone": "Asia/Colombo",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Components up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 5 }, { "color": "green", "value": 6 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none" },
      "targets": [{ "refId": "A", "expr": "count(up{job=~\"prometheus|alertmanager|loki|tempo|grafana|otel-collector\"} == 1)", "instant": true }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Series in TSDB",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "prometheus_tsdb_head_series", "instant": true }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Rule evaluation failures/s",
      "description": "A rule that fails to evaluate is an alert that cannot fire. Silent by construction — nothing else on the platform changes.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.0001 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(rate(prometheus_rule_evaluation_failures_total[5m]))", "instant": true }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Notifications failed/s",
      "description": "Alertmanager could not deliver. The alert fired and nobody was told.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.0001 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(rate(alertmanager_notifications_failed_total[5m]))", "instant": true }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Spans accepted/s",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "none", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(rate(otelcol_receiver_accepted_spans_total[5m]))", "instant": true }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Telemetry refused/s",
      "description": "The collector's memory_limiter shedding load, or an exporter rejecting. Refused telemetry is data the platform produced and this stack threw away.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.0001 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area" },
      "targets": [{ "refId": "A", "expr": "sum(rate(otelcol_receiver_refused_spans_total[5m])) + sum(rate(otelcol_receiver_refused_log_records_total[5m])) + sum(rate(otelcol_receiver_refused_metric_points_total[5m]))", "instant": true }]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Scrape targets up, by job",
      "description": "Both deployment shapes are in prometheus.yml — one container per service, and the D7' §2.1 composition hosts — so the shape that is not running reads as down. That is why TargetDown is warning-only and slow.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "refId": "A", "expr": "sum by (job) (up)", "legendFormat": "{{job}}" }]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Collector pipelines — accepted and sent",
      "description": "The three legs: spans to Tempo, logs to Loki, metrics to the Prometheus exposition on :8889. The metrics leg is the only path tcp-adapter has, because it runs on runtime:10.0-alpine with no HTTP surface to scrape.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(otelcol_receiver_accepted_spans_total[$__rate_interval]))", "legendFormat": "spans accepted" },
        { "refId": "B", "expr": "sum(rate(otelcol_exporter_sent_spans_total[$__rate_interval]))", "legendFormat": "spans → Tempo" },
        { "refId": "C", "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[$__rate_interval]))", "legendFormat": "logs accepted" },
        { "refId": "D", "expr": "sum(rate(otelcol_exporter_sent_log_records_total[$__rate_interval]))", "legendFormat": "logs → Loki" },
        { "refId": "E", "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[$__rate_interval]))", "legendFormat": "metric points accepted" },
        { "refId": "F", "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[$__rate_interval]))", "legendFormat": "export failures" }
      ]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Prometheus — series, scrape duration and rule evaluation",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": ".*duration.*" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }] }] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "prometheus_tsdb_head_series", "legendFormat": "head series" },
        { "refId": "B", "expr": "max(scrape_duration_seconds)", "legendFormat": "slowest scrape duration" },
        { "refId": "C", "expr": "max(prometheus_rule_group_last_duration_seconds)", "legendFormat": "slowest rule group duration" },
        { "refId": "D", "expr": "sum(rate(prometheus_rule_evaluation_failures_total[$__rate_interval]))", "legendFormat": "rule failures/s" }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Alertmanager — alerts received and notifications sent",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "lineWidth": 1, "fillOpacity": 5, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(alertmanager_alerts_received_total[$__rate_interval]))", "legendFormat": "alerts received/s" },
        { "refId": "B", "expr": "sum by (integration) (rate(alertmanager_notifications_total[$__rate_interval]))", "legendFormat": "notifications · {{integration}}" },
        { "refId": "C", "expr": "sum(rate(alertmanager_notifications_failed_total[$__rate_interval]))", "legendFormat": "failed/s" },
        { "refId": "D", "expr": "sum(alertmanager_alerts{state=\"suppressed\"})", "legendFormat": "suppressed (inhibited or silenced)" }
      ]
    },

    {
      "id": 30,
      "type": "table",
      "title": "Every alert rule and its runbook",
      "description": "49 rules across five files. verify-observability.sh fails if any runbook_url names a file that does not exist, which is what makes this table a contract rather than a list of good intentions.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true },
      "targets": [{ "refId": "A", "expr": "ALERTS", "instant": true, "format": "table" }],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true, "instance": true, "job": true, "environment": true, "platform": true }, "renameByName": { "alertname": "Alert", "alertstate": "State", "severity": "Severity", "plane": "Plane", "slo": "SLO", "stuck_state": "Stuck state", "service": "Service" } } }
      ]
    }
  ]
}
