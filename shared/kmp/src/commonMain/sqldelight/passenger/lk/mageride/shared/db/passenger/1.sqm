-- Migration 1 -> 2 · mobile_db_schema.md §8 Δ 2026-07-05 #2 (URD v2.7 Epic 26, ADD v3.1 §1.13):
-- driver-QR attestation settlement (AL-47) and number-masking removal (AL-48).
--
-- Version 1 is the on-device schema as of Δ 2026-06-28 (§1-§3 plus §6). The spec prints this
-- change set as `ALTER TABLE … ADD COLUMN` / `RENAME COLUMN`, but `ALTER TABLE … RENAME COLUMN`
-- needs SQLite 3.25 and URD NFR-22 pins minSdk 26 — Android 8.0 ships SQLite 3.19. A handset on
-- API 26 running the platform SQLite would fail the migration and be left on a schema no query
-- matches, so the renames are done the portable way: rebuild, copy, swap. The result is
-- structurally identical to what `.sq` creates on a fresh install, which MigrationTest asserts
-- column for column and index for index.

-- ---- rides (§2.3): +qr_claimed_at, rider_phone_masked -> rider_phone, driver_phone_masked ->
-- ---- driver_phone. The two phone columns are NULL until Accepted (US-26.2), so the copy below
-- ---- preserves whatever the old build had cached, masked or not.
DROP INDEX ix_prides_active;
DROP INDEX ix_prides_history;
ALTER TABLE rides RENAME TO rides_v1;

CREATE TABLE rides (
    id                    TEXT NOT NULL PRIMARY KEY,
    client_request_id     TEXT NOT NULL,
    state                 TEXT NOT NULL,
    is_active             INTEGER AS Boolean NOT NULL DEFAULT 1,
    kind                  INTEGER AS Int NOT NULL DEFAULT 0,
    is_proxy              INTEGER AS Boolean NOT NULL DEFAULT 0,
    vehicle_type          TEXT NOT NULL,
    pickup_lat            REAL NOT NULL,
    pickup_lng            REAL NOT NULL,
    pickup_label          TEXT,
    dropoff_lat           REAL NOT NULL,
    dropoff_lng           REAL NOT NULL,
    dropoff_label         TEXT,
    rider_name            TEXT,
    rider_phone           TEXT,
    package_size          TEXT CHECK (package_size IS NULL OR package_size IN ('S','M','L')),
    package_description   TEXT,
    accepted_driver_id    TEXT,
    driver_name           TEXT,
    driver_photo_url      TEXT,
    driver_rating         REAL,
    driver_phone          TEXT,
    vehicle_reg           TEXT,
    vehicle_actual_type   TEXT,
    vehicle_lat           REAL,
    vehicle_lng           REAL,
    vehicle_heading_deg   INTEGER AS Int,
    offer_expires_at      INTEGER AS Instant,
    fare_amount_minor     INTEGER,
    surcharge_minor       INTEGER NOT NULL DEFAULT 0,
    tip_amount_minor      INTEGER NOT NULL DEFAULT 0,
    payment_method        TEXT CHECK (payment_method IN ('cash','lankaqr','onepay','cod')),
    payment_state         TEXT,
    qr_claimed_at         INTEGER AS Instant,
    created_at            INTEGER AS Instant NOT NULL,
    updated_at            INTEGER AS Instant NOT NULL,
    terminal_at           INTEGER AS Instant,
    server_updated_at     INTEGER AS Instant,
    synced_at             INTEGER AS Instant
);

INSERT INTO rides (
    id, client_request_id, state, is_active, kind, is_proxy, vehicle_type,
    pickup_lat, pickup_lng, pickup_label, dropoff_lat, dropoff_lng, dropoff_label,
    rider_name, rider_phone, package_size, package_description,
    accepted_driver_id, driver_name, driver_photo_url, driver_rating, driver_phone,
    vehicle_reg, vehicle_actual_type, vehicle_lat, vehicle_lng, vehicle_heading_deg, offer_expires_at,
    fare_amount_minor, surcharge_minor, tip_amount_minor, payment_method, payment_state, qr_claimed_at,
    created_at, updated_at, terminal_at, server_updated_at, synced_at
)
SELECT
    id, client_request_id, state, is_active, kind, is_proxy, vehicle_type,
    pickup_lat, pickup_lng, pickup_label, dropoff_lat, dropoff_lng, dropoff_label,
    rider_name, rider_phone_masked, package_size, package_description,
    accepted_driver_id, driver_name, driver_photo_url, driver_rating, driver_phone_masked,
    vehicle_reg, vehicle_actual_type, vehicle_lat, vehicle_lng, vehicle_heading_deg, offer_expires_at,
    fare_amount_minor, surcharge_minor, tip_amount_minor, payment_method, payment_state, NULL,
    created_at, updated_at, terminal_at, server_updated_at, synced_at
FROM rides_v1;

DROP TABLE rides_v1;
CREATE INDEX ix_prides_active ON rides(is_active, updated_at DESC);
CREATE INDEX ix_prides_history ON rides(created_at DESC);

-- ---- location_requests (§2.5): rider_phone_masked -> rider_phone.
ALTER TABLE location_requests RENAME TO location_requests_v1;

CREATE TABLE location_requests (
    request_id          TEXT NOT NULL PRIMARY KEY,
    ride_id             TEXT,
    rider_phone         TEXT,
    state               TEXT NOT NULL DEFAULT 'Pending'
                          CHECK (state IN ('Pending','Confirmed','Declined','Expired','RiderNotRegistered')),
    issued_at           INTEGER AS Instant NOT NULL,
    ttl_seconds         INTEGER AS Int NOT NULL DEFAULT 300,
    resolved_lat        REAL,
    resolved_lng        REAL,
    resolved_accuracy_m REAL,
    resolved_at         INTEGER AS Instant
);

INSERT INTO location_requests (
    request_id, ride_id, rider_phone, state, issued_at, ttl_seconds,
    resolved_lat, resolved_lng, resolved_accuracy_m, resolved_at
)
SELECT
    request_id, ride_id, rider_phone_masked, state, issued_at, ttl_seconds,
    resolved_lat, resolved_lng, resolved_accuracy_m, resolved_at
FROM location_requests_v1;

DROP TABLE location_requests_v1;
