import kotlin.time.Instant;
import kotlin.Int;

-- mobile_db_schema.md §2.2 — recent / searched locations. Local-only UX: nothing here syncs, so
-- there is no `dirty`, no `synced_at` and no outbox partner.
CREATE TABLE place_recents (
    id           TEXT NOT NULL PRIMARY KEY,
    label        TEXT NOT NULL,
    line1        TEXT,
    lat          REAL NOT NULL,
    lng          REAL NOT NULL,
    use_count    INTEGER AS Int NOT NULL DEFAULT 1,
    last_used_at INTEGER AS Instant NOT NULL
);
CREATE INDEX ix_recents_recent ON place_recents(last_used_at DESC);

selectRecent:
SELECT * FROM place_recents ORDER BY last_used_at DESC LIMIT ?;

selectFrequent:
SELECT * FROM place_recents ORDER BY use_count DESC, last_used_at DESC LIMIT ?;

insert:
INSERT OR REPLACE INTO place_recents (id, label, line1, lat, lng, use_count, last_used_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- The label is rewritten, not only the counters. A place chosen again is a fresh geocode of the
-- same coordinate, so it carries the CURRENT language (D-26) and any name OSM has corrected since;
-- keeping the stored one would pin whichever language the passenger first found it in.
touch:
UPDATE place_recents
SET use_count = use_count + 1, last_used_at = ?, label = ?, line1 = ?
WHERE id = ?;

-- Re-label in place, for the sweep that follows a language change. Deliberately touches neither
-- `use_count` nor `last_used_at`: translating a row is not the passenger using it, and reordering
-- their list because they changed language would be a strange thing to do to them.
relabel:
UPDATE place_recents SET label = ?, line1 = ? WHERE id = ?;

deleteBeyondCap:
DELETE FROM place_recents
WHERE rowid IN (SELECT rowid FROM place_recents ORDER BY last_used_at DESC, id LIMIT -1 OFFSET :keep);

deleteAll:
DELETE FROM place_recents;
