import kotlin.time.Instant;

-- mobile_db_schema.md §3.7 — driver wallet balance cache (single row, D-08).
--
-- A ~5 s CACHE HINT, never the authority: the server ledger (`billing.journal_entries`) is the
-- only balance that decides anything. It exists to render the "insufficient balance for the 2nd
-- trip" gate before going online without a round trip. Balances may be negative.
CREATE TABLE wallet (
    id            INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    account_id    TEXT,
    balance_minor INTEGER NOT NULL DEFAULT 0,
    currency      TEXT NOT NULL DEFAULT 'LKR',
    updated_at    INTEGER AS Instant NOT NULL,
    synced_at     INTEGER AS Instant
);

select:
SELECT * FROM wallet WHERE id = 1;

upsert:
INSERT OR REPLACE INTO wallet (id, account_id, balance_minor, currency, updated_at, synced_at)
VALUES (1, ?, ?, ?, ?, ?);

deleteAll:
DELETE FROM wallet;
