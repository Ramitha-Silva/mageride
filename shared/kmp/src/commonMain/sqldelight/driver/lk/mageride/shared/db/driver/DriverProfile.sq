import kotlin.Int;
import kotlin.time.Instant;

-- mobile_db_schema.md §3.16 (Δ MCS-27) — the driver's own identity, cached so SCR-DA/DI-029 and
-- SCR-DA/DI-036 paint a name rather than a placeholder on the frame they open.
--
-- Every column is a cache of something a server owns. Nothing reads this as truth: it decides the
-- first frame and is replaced by whatever the refresh behind it answers.
CREATE TABLE driver_profile (
    driver_id     TEXT NOT NULL PRIMARY KEY,
    display_name  TEXT,
    level         INTEGER AS Int,
    registration  TEXT,
    photo_url     TEXT,
    photo_version TEXT,
    photo_bytes   BLOB,
    synced_at     INTEGER AS Instant
);

select:
SELECT * FROM driver_profile WHERE driver_id = ?;

-- UPDATE-then-INSERT rather than an UPSERT, and not by preference: `ON CONFLICT ... DO UPDATE` is
-- SQLite 3.24 and this module's dialect is pinned at 3.18, because minSdk 26 means Android 8.0,
-- which ships 3.19. The UPDATE is a no-op when the row is absent and the INSERT is a no-op when it
-- is present, so the pair is one upsert either way.
--
-- **Two labelled queries, NOT one grouped statement, and the difference was a shipped defect**
-- (Δ MCS-33). Written as `upsertIdentity:` with both statements under one label, SQLDelight emitted
-- the UPDATE and silently DROPPED the INSERT — no warning, a clean build, and a generated file with
-- the word `INSERT` nowhere in it. So the UPDATE matched nothing for a driver with no row yet, the
-- table stayed empty for ever, and every read answered an empty profile: SCR-DA/DI-029 and -036
-- opened on `profile_unnamed` and no avatar on every launch, which is the defect MCS-27, -29, -31
-- and -32 each tried to fix from the screen end. Do not fold these back into one label.
--
-- `INSERT OR IGNORE` suppresses every constraint and not only the primary key. That is safe here
-- and nowhere near a general licence: `driver_id` is the only constraint this table has, and a
-- second insert for a row that already exists is the designed path rather than a swallowed error.

-- The identity half, written by a completed profile read. Deliberately does NOT touch the photo
-- columns: the name and the avatar arrive from different calls at different times, and a name
-- refresh must not blank an avatar that is already on screen. `coalesce` is the same rule within
-- the row — a read that answered a name but not a level leaves the level alone.
updateIdentity:
UPDATE driver_profile
   SET display_name = coalesce(:displayName, display_name),
       level        = coalesce(:level, level),
       registration = coalesce(:registration, registration),
       synced_at    = :syncedAt
 WHERE driver_id = :driverId;

-- The other half. Run second and in the same transaction as `updateIdentity`, by `writeIdentity`.
insertIdentity:
INSERT OR IGNORE INTO driver_profile (driver_id, display_name, level, registration, synced_at)
VALUES (:driverId, :displayName, :level, :registration, :syncedAt);

-- The photograph, written only once its bytes are actually in hand. `photo_version` is the signed
-- link's opaque `v`: it changes when and only when the photograph does, which is what tells a later
-- read whether the bytes it already holds are still the right ones. Replaced outright rather than
-- coalesced — a photo read that answered is the whole answer.
updatePhoto:
UPDATE driver_profile
   SET photo_url     = :photoUrl,
       photo_version = :photoVersion,
       photo_bytes   = :photoBytes,
       synced_at     = :syncedAt
 WHERE driver_id = :driverId;

-- The other half. Run second and in the same transaction as `updatePhoto`, by `writePhoto`.
insertPhoto:
INSERT OR IGNORE INTO driver_profile (driver_id, photo_url, photo_version, photo_bytes, synced_at)
VALUES (:driverId, :photoUrl, :photoVersion, :photoBytes, :syncedAt);

-- D-26/PDPA and sign-out: the identity of the driver who was signed in must not survive the next
-- one arriving on the same handset.
deleteAll:
DELETE FROM driver_profile;
