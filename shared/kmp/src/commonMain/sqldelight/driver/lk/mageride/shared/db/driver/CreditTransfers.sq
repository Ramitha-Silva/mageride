import kotlin.time.Instant;

-- mobile_db_schema.md §3.15 — driver-to-driver credit transfer cache (AL-01, US-9.13), post-Δ§8
-- (AL-48 unmasked counterparty number).
--
-- "Reseller" is NOT a role, account or capability: any driver holding bulk credit can transfer it
-- to another by Driver ID, and the transfer moves the EXACT value with no commission. There is no
-- commission column here because there is no commission — see C016's CreditTransferRules, whose
-- two postings sum to zero.
CREATE TABLE credit_transfers (
    id                     TEXT NOT NULL PRIMARY KEY,
    direction              TEXT NOT NULL CHECK (direction IN ('incoming','outgoing')),
    counterparty_driver_id TEXT,                                   -- the other driver's Driver ID
    counterparty_name      TEXT,
    counterparty_phone     TEXT,
    amount_minor           INTEGER NOT NULL,                       -- exact value, no commission
    status                 TEXT NOT NULL CHECK (status IN ('PENDING','APPROVED','REJECTED')),
    created_at             INTEGER AS Instant NOT NULL,
    synced_at              INTEGER AS Instant
);
CREATE INDEX ix_credit_transfers_recent ON credit_transfers(created_at DESC);

selectRecent:
SELECT * FROM credit_transfers ORDER BY created_at DESC LIMIT :limit;

selectPending:
SELECT * FROM credit_transfers WHERE status = 'PENDING' ORDER BY created_at DESC;

upsert:
INSERT OR REPLACE INTO credit_transfers (
    id, direction, counterparty_driver_id, counterparty_name, counterparty_phone,
    amount_minor, status, created_at, synced_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteBefore:
DELETE FROM credit_transfers WHERE created_at < ?;

deleteAll:
DELETE FROM credit_transfers;
