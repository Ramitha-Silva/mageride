# =====================================================================================
# Fleet Portal (C111) — fleet.mageride.lk
#
# Every value here is read on the SERVER. There is no `NEXT_PUBLIC_*` variable and there
# must not be one that carries a URL or a secret: the browser never talks to the gateway
# directly, never holds an access token, and never learns where fleet-svc lives. Every
# call goes out of the Next server with the session cookie exchanged for a bearer.
#
# Read at runtime, not inlined at build: the portal is one image (`output: 'standalone'`)
# deployed to the replica and to DOKS with different values.
# =====================================================================================

# The C008 API gateway origin. `/v1/fleets/**` reaches fleet-svc — and, at Order 20,
# fleet-health-svc for `/health`, fleet-billing-svc for `/billing` and `/wallet` —
# while `/v1/auth/**` and `/v1/me/**` reach iam-svc. The portal knows one host, not four.
# REQUIRED. Absent, every request answers 503 and start-up logs the reason.
MAGERIDE_API_BASE_URL=http://api-gateway:8080

# --- Federated sign-in (AL-07). Both optional: the password arm works without them. --
#
# Both arms use the OIDC **implicit ID-token** flow with `response_mode=form_post`, so
# the provider POSTs the identity token back to the callback below and iam-svc verifies
# it against the provider's JWKS. This portal holds NO client secret — there is nothing
# to redeem a code with and nothing here that mints a session.
#
# Because the response is a cross-site POST, the ten-minute OAuth state cookie is set
# `SameSite=None`, which browsers only honour with `Secure`. On a plain-HTTP host
# (FLEET_PORTAL_COOKIE_SECURE=false) that cookie will not come back and federated
# sign-in cannot complete — use the password arm there.
#
# UNSET hides the corresponding button rather than rendering one that cannot work.

# Google. The client id must be one iam-svc validates the ID token's audience against
# (`Oidc__Google__ClientIds__0` in infra/env/.env.app.example).
GOOGLE_OIDC_CLIENT_ID=
# Registered on the Google client, byte for byte. Google matches it exactly.
GOOGLE_OIDC_REDIRECT_URI=https://fleet.mageride.lk/auth/callback/google

# Apple. The client id is the **Services ID**, not the App ID, and it must be the
# audience iam-svc accepts for Apple identity tokens.
APPLE_OIDC_CLIENT_ID=
# Registered as a Return URL on the Services ID. Apple requires HTTPS and no fragment.
APPLE_OIDC_REDIRECT_URI=https://fleet.mageride.lk/auth/callback/apple

# --- Cookies -------------------------------------------------------------------------
# `Secure` on the session cookies. Leave true everywhere except a plain-HTTP dev host —
# a portal that drops it in production hands the session to any network in the path.
FLEET_PORTAL_COOKIE_SECURE=true

# How long before an access token expires the proxy rotates it (seconds). The token
# lives 30 minutes (D-29); this is the margin, not the lifetime.
FLEET_PORTAL_REFRESH_SKEW_SECONDS=120

# How long the proxy may reuse one caller's evaluated seat and organisation status
# (seconds). It bounds how stale a *route guard* can be, never how stale an answer is:
# fleet-svc re-reads `iam.fleet_members` on every request, so the cost of a hit here is
# a screen that renders and then 403s its own data — and a verification approval that
# takes this long to open the vehicle screens.
FLEET_PORTAL_SESSION_CACHE_SECONDS=15
