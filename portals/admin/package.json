{
  "name": "@mageride/admin-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Admin Portal application shell at admin.mageride.lk (Next.js) — session, role-scoped nav and the admin-bff data layer (AL-02/AL-06/AL-37/AL-52, D-35).",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "node ../scripts/ensure-workspace-deps.mjs",
    "dev": "next dev",
    "prebuild": "node ../scripts/ensure-workspace-deps.mjs",
    "build": "next build && node scripts/check-bundle.mjs",
    "start": "next start",
    "prelint": "node ../scripts/ensure-workspace-deps.mjs",
    "lint": "eslint . && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "pretest": "node ../scripts/ensure-workspace-deps.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@mageride/i18n": "*",
    "@mageride/tailwind-preset": "*",
    "@mageride/ui": "*",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@mageride/eslint-config": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3"
  }
}
