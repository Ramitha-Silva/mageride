# =====================================================================================
# Admin Portal (C104) — admin.mageride.lk
#
# Every value here is read on the SERVER. There is no `NEXT_PUBLIC_*` variable and there
# must not be one that carries a URL or a secret: the browser never talks to the gateway
# directly, never holds an access token, and never learns where admin-bff lives. Every
# call goes out of the Next server with the session cookie exchanged for a bearer.
#
# Read at runtime, not inlined at build: the portal is one image (`output: 'standalone'`)
# deployed to the replica and to DOKS with different values.
# =====================================================================================

# The C008 API gateway origin. `/v1/admin/**` reaches admin-bff, `/v1/admin/auth/**` and
# `/v1/auth/**` reach iam-svc (gateway Order 20) — the portal knows one host, not five.
# REQUIRED. Absent, every request answers 503 and start-up logs the reason.
MAGERIDE_API_BASE_URL=http://api-gateway:8080

# --- Google Sign-In (AL-07). Optional: the password arm works without it. ------------
# Must be the SAME OAuth client id iam-svc validates the ID token's audience against
# (`Oidc__Google__ClientIds__0` in infra/env/.env.app.example) — a code exchanged for a
# token minted for a different client is refused there, which is the point of that list.
# UNSET hides the Google button rather than rendering one that cannot work.
GOOGLE_OIDC_CLIENT_ID=
# Must equal iam-svc's `Oidc__Google__RedirectUri` AND be registered on the Google client.
# Google matches it exactly; iam-svc passes it back on the code exchange.
GOOGLE_OIDC_REDIRECT_URI=https://admin.mageride.lk/auth/callback

# --- Cookies -------------------------------------------------------------------------
# `Secure` on the session cookies. Leave true everywhere except a plain-HTTP dev host —
# a portal that drops it in production hands the session to any network in the path.
ADMIN_PORTAL_COOKIE_SECURE=true

# How long before an access token expires the proxy rotates it (seconds). The token
# lives 30 minutes (D-29); this is the margin, not the lifetime.
ADMIN_PORTAL_REFRESH_SKEW_SECONDS=120

# How long the proxy may reuse one caller's evaluated permissions before asking
# admin-bff again (seconds). It bounds how stale a *route guard* can be, never how
# stale an answer is: every endpoint re-evaluates AL-06 on its own, so the cost of a
# hit here is a screen that renders and then 403s its own data.
ADMIN_PORTAL_SESSION_CACHE_SECONDS=15
