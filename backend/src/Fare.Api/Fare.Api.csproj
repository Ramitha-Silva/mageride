<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Fare.Api (C049 fare-svc-core; C050 adds the payment state machine)

    Mode C fare computation and driver earnings: the fares.tariffs / fares.peak_windows rate card,
    the upfront estimate and the fareEstimateToken that binds it, the E-04 Kalman filter and
    accuracy-weighted resample that the final distance is measured with, the D-05 cross-trip
    cancellation settlement, and the Initiated fares.ride_payments row a completed ride produces.

    NOT here, and fenced out of C049 on purpose: everything after Initiated. The payment state
    machine, OnePay (+5%), LankaQR, cash, COD and driver-QR attestation (D-10, AL-22, AL-47), the
    tip capture (E-10), the refund/dispute workflow (E-05) and the R-05 terminal that posts a
    driver's earning are all C050. A stubbed payment endpoint is worse than an absent one: it
    answers 200 to a client that then believes money moved.

    Verify: dotnet test backend/src/Fare.Api.Tests -c Release
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.Fare</RootNamespace>
    <AssemblyName>MageRide.Fare.Api</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>mageride-fare-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MageRide.Shared\MageRide.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ride.Api.Tests drives the estimate end to end into POST /v1/rides/request (C022). -->
    <InternalsVisibleTo Include="Ride.Api.Tests" />
    <InternalsVisibleTo Include="Fare.Api.Tests" />
  </ItemGroup>

</Project>
