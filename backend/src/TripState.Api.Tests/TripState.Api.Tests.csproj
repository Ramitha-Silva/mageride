<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    C031 verify target: dotnet test backend/src/TripState.Api.Tests -c Release

    Almost everything here needs a real database, and that is not incidental: the active-session
    mutex IS `ux_sessions_active_driver`, the arrival fence IS an ST_DWithin on a geography column,
    and the one-rating rule IS a unique index. None of the three is provable against a fake, and a
    test that asserted them in C# would pass while the invariant they stand for did not hold.

    Microsoft.NET.Sdk.Web, not Microsoft.NET.Sdk: the harness builds a WebApplication.
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.TripState.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!--
      xUnit1041: collection-fixture ctor args are consumed through the primary constructor.
      xUnit1051: every test is bounded by its own harness lifetime, so threading
                 TestContext.Current.CancellationToken through each HTTP call would add noise
                 without changing behaviour. Matches Registry.Api.Tests and Provisioning.Api.Tests.
    -->
    <NoWarn>$(NoWarn);xUnit1041;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- R-15/T-04: the last will is published by a real broker, and a fake would prove only that
         this service can parse a string it wrote itself. -->
    <PackageReference Include="MQTTnet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TripState.Api\TripState.Api.csproj" />
    <ProjectReference Include="..\MageRide.TestKit\MageRide.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
