<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Ride.Api (C022 ws-ride-svc-happy-path, + C023 Δ, + C032 ride-svc-core) — the Mode C ride
    aggregate.

    ride-svc is the SOLE writer of rides.state (R-01, D5' §6). Mode A/B tracking sessions are
    trip-state-svc's and that boundary is never crossed.

    What this implements: the whole D5' §6 / ADD Appendix B.2 state machine — the happy path from
    Requested to PaymentPending with the ADD §11.11 atomic single-winner accept, the §11.12
    server-owned cancellation and no-show matrix, the R-04 durable timers (arrival grace, rider
    no-show, the R-15/R-16 per-state offline graces, the R-20 payment watch), R-18's dual-key
    idempotency, the rides.command_log replay, the R-05 payment terminals and the rides.outbox
    writes the LISTEN/NOTIFY dispatcher drains to Redpanda (E-09, R-13).

    NOT here: proxy booking and location requests, package delivery and its OTPs (C037), the
    dispute ticket (E-05, C049/C050) and ride history (AL-36, C048). The R-04 `offer_expiry` timer
    kind is dispatch-svc's (ADD §6, C023) — see Domain/RideTimerKinds.cs.

    Verify: dotnet test backend/src/Ride.Api.Tests -c Release
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.Ride</RootNamespace>
    <AssemblyName>MageRide.Ride.Api</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>mageride-ride-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MageRide.Shared\MageRide.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- C032: the R-15 last-will subscription ADD §6 lists against ride-svc
         ("Consumes … veh/{vehicleId}/status (LWT)"). Same MQTT 5 client the bridge and
         trip-state-svc use; the version is pinned in backend/Directory.Packages.props. -->
    <PackageReference Include="MQTTnet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ride.Api.Tests" />
  </ItemGroup>

</Project>
