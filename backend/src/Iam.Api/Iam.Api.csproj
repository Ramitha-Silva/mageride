<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Iam.Api — iam-svc's authentication half (C020 ws-iam-minimal, completed by C026 iam-svc-auth).

    Every sign-in surface AL-07 lists: Phone OTP for the passenger and driver apps over one of two
    SMS gateways — Notify.lk (D6' §7.3) or Fit SMS — with a Dialog/Mobitel fallback behind either,
    selected by Sms:Provider; password or Google for the Admin
    Portal, email+password / Google / Apple for the Fleet Portal. RS256 access tokens over a
    rotating key ring with a published JWKS, opaque single-use refresh with reuse detection
    (D-29), device binding and one session per surface (AL-08), and the MQTT session JWT E-02
    decouples from all of it.

    Profile, saved addresses, the nine-role RBAC surface and PDPA are C027.
    There is no MFA here and never will be (AL-37).

    Verify: dotnet test backend/src/Iam.Api.Tests -c Release
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.Iam</RootNamespace>
    <AssemblyName>MageRide.Iam.Api</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>mageride-iam-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- iam-svc both mints and validates these tokens, so it uses the handler directly rather
         than only through the kernel's AddMageRideAuth. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MageRide.Shared\MageRide.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The trilingual OTP bodies (D-26). Embedded rather than copied to the output directory so
         an image cannot ship without them and fail at the first sign-in. -->
    <EmbeddedResource Include="Resources\sms-templates.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iam.Api.Tests" />
  </ItemGroup>

</Project>
