<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ApiGateway (C008) — the single public HTTP entry point.

    YARP reverse proxy + the four edge concerns D3' §0 / D6' §8.2 put here and nowhere else:
    the D-31 minimum-version gate, D-30 attestation enforcement, per-route rate limiting and
    request-id / traceparent propagation. No business logic, no database, no Kafka.

    Verify: dotnet test backend/src/ApiGateway.Tests -c Release
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.ApiGateway</RootNamespace>
    <AssemblyName>MageRide.ApiGateway</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>mageride-api-gateway</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MageRide.Shared\MageRide.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The route table is its own reviewable artifact rather than a section of appsettings.json.
         Cluster addresses still layer over it from the environment
         (ReverseProxy__Clusters__ride-svc__Destinations__primary__Address). The Web SDK already
         globs *.json as Content; this only pins it to the output directory. -->
    <Content Update="gateway-routes.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- Δ C127. The edge's security policy, pinned for the same reason and with more at stake: it
         carries the D-30 sensitive-operation set, the D-31 version floor and the rate-limit
         buckets, and as a section of appsettings.json it did not survive into the co-located
         AppServices image (C125) — which ran with no rate limit on any route and nothing marked
         sensitive. `PreserveNewest` on Content is what carries it into every publish output,
         including a referencing project's. -->
    <Content Update="gateway-policy.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiGateway.Tests" />
  </ItemGroup>

</Project>
