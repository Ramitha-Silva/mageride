{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Redis": "redis:6379"
  },

  "Otel": {
    "ServiceName": "api-gateway"
  },

  "Gateway": {
    "StateStore": "Redis",
    "EmitUpstreamHeader": false,
    "RewriteTraceParent": true,
    "BlockedPathPrefixes": [ "/v1/internal" ],

    "ForwardedHeaders": {
      "//": "C009 / C125 must add the HAProxy address here, or every caller shares one rate-limit bucket.",
      "ForwardLimit": 1,
      "KnownProxies": [],
      "KnownNetworks": []
    },

    "VersionGate": {
      "//": [
        "D-31. MinimumVersion is the hard floor: below it every proxied request is answered 426.",
        "RecommendedVersion is the soft floor: at or above the hard floor but below this,",
        "GET /v1/version/check reports updateRequired with isMandatory:false so the app can show a",
        "dismissible prompt (US-17.1 soft vs US-17.2 mandatory).",
        "The values below are placeholders for the first store builds; Wave 4a/4b set the real ones."
      ],
      "Enabled": true,
      "RequirePlatformHeader": false,
      "Platforms": {
        "android": {
          "MinimumVersion": "1.0.0",
          "RecommendedVersion": "1.0.0",
          "LatestVersion": "1.0.0",
          "UpdateUrl": "https://play.google.com/store/apps/details?id=lk.mageride.passenger"
        },
        "ios": {
          "MinimumVersion": "1.0.0",
          "RecommendedVersion": "1.0.0",
          "LatestVersion": "1.0.0",
          "UpdateUrl": "https://apps.apple.com/lk/app/mageride/id0000000000"
        }
      }
    },

    "Attestation": {
      "//": [
        "D-30. SensitiveOperations is exactly the set of operations carrying the X-Attestation",
        "parameter in backend/contracts/*.yaml — auth, payments, ride accept, wallet and SOS",
        "(D3' §0). ApiGateway.Tests asserts the two sets are equal, so an endpoint that becomes",
        "sensitive in the contract fails the build until it is listed here."
      ],
      "Mode": "Enforce",
      "PlatformModes": {},
      "MaxTokenLength": 8192,

      "PlayIntegrity": {
        "PackageName": "",
        "Endpoint": "https://playintegrity.googleapis.com",
        "RequiredAppVerdicts": [ "PLAY_RECOGNIZED" ],
        "RequiredDeviceVerdicts": [ "MEETS_DEVICE_INTEGRITY" ],
        "RequiredLicensingVerdicts": [],
        "MaxTokenAge": "00:05:00",
        "VerdictCacheDuration": "00:05:00",
        "RequestTimeout": "00:00:05"
      },

      "AppAttest": {
        "AppId": "",
        "MaxAssertionBytes": 4096,
        "RequireCounterIncrease": true
      },

      "SensitiveOperations": [
        { "Methods": [ "POST" ], "Path": "/v1/auth/otp/request" },
        { "Methods": [ "POST" ], "Path": "/v1/auth/otp/verify" },

        { "Methods": [ "POST" ], "Path": "/v1/fare/pay" },
        { "Methods": [ "POST" ], "Path": "/v1/fare/pay/scan-driver-qr" },
        { "Methods": [ "POST" ], "Path": "/v1/fare/pay/driver-qr/claim" },
        { "Methods": [ "POST" ], "Path": "/v1/fare/pay/driver-qr/confirm" },

        { "Methods": [ "POST" ], "Path": "/v1/wallet/topup/onepay" },
        { "Methods": [ "POST" ], "Path": "/v1/wallet/topup/lankaqr" },
        { "Methods": [ "POST" ], "Path": "/v1/wallet/credit-transfer/initiate" },
        { "Methods": [ "POST" ], "Path": "/v1/wallet/credit-transfer/request" },
        { "Methods": [ "POST" ], "Path": "/v1/wallet/credit-transfer/{transferId}/approve" },
        { "Methods": [ "POST" ], "Path": "/v1/wallet/voucher/purchase" },

        { "Methods": [ "POST" ], "Path": "/v1/subscriptions/credit-transfer/{transferId}/approve" },
        { "Methods": [ "POST" ], "Path": "/v1/transfers/driver" },
        { "Methods": [ "POST" ], "Path": "/v1/vouchers/purchase" },

        { "Methods": [ "POST" ], "Path": "/v1/rides/request" },
        { "Methods": [ "POST" ], "Path": "/v1/rides/{rideId}/offer/{driverId}/accept" },
        { "Methods": [ "POST" ], "Path": "/v1/rides/{rideId}/cod-collected" },
        { "Methods": [ "POST" ], "Path": "/v1/location-requests" },
        { "Methods": [ "POST" ], "Path": "/v1/rides/schedule" },

        { "Methods": [ "POST" ], "Path": "/v1/sos" },
        { "Methods": [ "POST" ], "Path": "/v1/voip/token" },

        { "Methods": [ "POST" ], "Path": "/v1/vehicles" },
        { "Methods": [ "POST" ], "Path": "/v1/trackers/bind" },
        { "Methods": [ "POST" ], "Path": "/v1/fleets/{fleetId}/trackers/bulk" }
      ]
    },

    "RateLimits": {
      "//": [
        "Coarse edge ceilings per route and caller address (D6' §8.2). The named business limits",
        "stay in the services that own them — OTP 5/h + 60 s cooldown (D-32) keys on a phone number",
        "and proxy location requests 5/h + 30/d (P-12) key on a booker id, neither of which the",
        "edge can see. Capacity is the burst; RefillTokens per RefillPeriod is the sustained rate."
      ],
      "Enabled": true,
      "FailOpen": true,
      "Policies": {
        "default": { "Capacity": 300, "RefillTokens": 300, "RefillPeriod": "00:01:00" },
        "write": { "Capacity": 120, "RefillTokens": 120, "RefillPeriod": "00:01:00" },
        "auth": { "Capacity": 30, "RefillTokens": 30, "RefillPeriod": "00:01:00" },
        "admin": { "Capacity": 600, "RefillTokens": 600, "RefillPeriod": "00:01:00" },
        "geo": { "Capacity": 120, "RefillTokens": 120, "RefillPeriod": "00:01:00" },
        "public-track": { "Capacity": 60, "RefillTokens": 60, "RefillPeriod": "00:01:00" },
        "realtime": { "Capacity": 60, "RefillTokens": 60, "RefillPeriod": "00:01:00" },
        "sos": { "Capacity": 20, "RefillTokens": 20, "RefillPeriod": "00:01:00" }
      }
    }
  }
}
