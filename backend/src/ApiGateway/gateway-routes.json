      "fleet-health-svc": {
        "//": [
          "C044. fleet-health-svc runs inside the `hot-path` container (D7' §2.1) beside",
          "mqtt-bridge, position-processor and persistence-writer, so in the dev compose the",
          "destination is that container's name; on DOKS it is the service's own pod. The host",
          "publishes no port for it — the gateway reaches it over the compose network, which is",
          "why `hot-path` still declares no `ports:`."
        ],
        "Destinations": { "primary": { "Address": "http://hot-path:5000/" } }
      },
      "admin-bff": { "Destinations": { "primary": { "Address": "http://admin-bff:5000/" } } },
      "public-bff": { "Destinations": { "primary": { "Address": "http://public-bff:5000/" } } },

      "fanout-svc": {
        "//": [
          "SignalR (D7' §2.1: the fanout container listens on 5001). HTTP/1.1 is pinned because a",
          "WebSocket upgrade cannot be negotiated over HTTP/2, and ActivityTimeout is raised well",
          "past YARP's 100 s default so a quiet-but-live hub connection is not torn down. It is",
          "raised, not removed: without a ceiling every half-open socket leaks a connection slot."
        ],
        "HttpRequest": {
          "ActivityTimeout": "00:30:00",
          "Version": "1.1",
          "VersionPolicy": "RequestVersionOrLower"
        },
        "Destinations": { "primary": { "Address": "http://fanout-svc:5001/" } }
      }
