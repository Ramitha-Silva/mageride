        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/v1/admin/{**remainder}" },
        "Metadata": { "RateLimit": "admin" }
      },
      "admin-bff-pdpa": {
        "ClusterId": "admin-bff",
        "Order": 90,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/v1/pdpa/{**remainder}" },
        "Metadata": { "RateLimit": "default" }
      }
    },

    "Clusters": {
