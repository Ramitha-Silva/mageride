<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    C044 verify target: dotnet test backend/src/FleetHealth.Tests -c Release

    Real Postgres, real Redpanda, real EMQX. Every claim this component makes is a claim about
    something outside the process:

      * the state ladder is `telemetry.device_health_state()`, a SQL function — a C# copy would
        prove nothing about the answer the dashboard gives;
      * "exactly one alert per window" is `ux_fleet_health_alert_window`, an index;
      * the fleet scoping is a session GUC and a security-barrier view, which only a real server
        evaluates;
      * the window rollup reads `telemetry.fleet_health_5m`, a TimescaleDB continuous aggregate
        that `postgis/postgis` cannot even create;
      * the last will arrives over a broker running the repository's own acl.conf, and a refused
        subscription's failure mode is silence.

    Microsoft.NET.Sdk.Web, not Microsoft.NET.Sdk: the harness builds a WebApplication.
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.FleetHealth.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!--
      xUnit1041: collection-fixture ctor args are consumed through the primary constructor.
      xUnit1051: every test is bounded by its own harness lifetime, so threading
                 TestContext.Current.CancellationToken through each call would add noise without
                 changing behaviour. Matches Dispatch/TripState/HotPath.Tests.
    -->
    <NoWarn>$(NoWarn);xUnit1041;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- The device-plane half is a real MQTT client publishing a real last will and a real
         diagnostics frame against the deployed ACL. -->
    <PackageReference Include="MQTTnet" />
    <!-- `telemetry.normalized` and `provisioning.events` are fed by producing to them, and
         `fleet.events` is asserted by consuming it — so the outbox claim is made against the
         broker rather than against a table this service wrote. -->
    <PackageReference Include="Confluent.Kafka" />
    <!-- FakeTimeProvider: the state ladder is thirty minutes wide and no suite can wait for it. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FleetHealth\FleetHealth.csproj" />
    <!-- C010: the Postgres, Redpanda and EMQX fixtures, so this suite runs the same server builds
         and — for EMQX — the same broker policy the dev stack does. -->
    <ProjectReference Include="..\MageRide.TestKit\MageRide.TestKit.csproj" />
    <!-- For four constants and one envelope. This service consumes provisioning-svc's
         `provisioning.events` and must not reference its code on the production path, so the
         event names are spelled on both sides; `BindingEventNamesTests` asserts the two agree.
         Without it a rename in C030 would show up as fleet dashboards that silently stop
         learning about new trackers. Dispatch.Api.Tests references Ride.Api for the same seam. -->
    <ProjectReference Include="..\Provisioning.Api\Provisioning.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
