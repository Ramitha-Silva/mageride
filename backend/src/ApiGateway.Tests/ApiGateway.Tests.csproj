<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    C008 verify target: dotnet test backend/src/ApiGateway.Tests -c Release

    The gateway and its stub upstreams are hosted on real Kestrel sockets rather than TestServer:
    YARP forwards over a real HttpMessageInvoker, and the SignalR passthrough test needs a genuine
    WebSocket upgrade to travel end to end. Nothing here needs Docker.

    Microsoft.NET.Sdk.Web, not Microsoft.NET.Sdk: the stub upstreams are WebApplications.
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.ApiGateway.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!--
      xUnit1051: every test is bounded by its own fixture's lifetime or an explicit timeout, so
                 threading TestContext.Current.CancellationToken through each HTTP call would add
                 noise without changing behaviour. Matches MageRide.Shared.Tests.
    -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiGateway\ApiGateway.csproj" />
    <!-- Container7CoLocationTests asserts the replica's Container 7 against this gateway's
         own route table. The reference is one-way: AppServices already references ApiGateway. -->
    <ProjectReference Include="..\AppServices\AppServices.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Δ C126 — THE SUBJECT UNDER TEST HAS TO WIN THE OUTPUT DIRECTORY.

    Both referenced projects ship an `appsettings.json` and the copy into this test's output is
    last-one-wins, so AppServices' file — Logging and AllowedHosts, no `Gateway` section at all —
    was landing on top of the gateway's. Everything that reads gateway configuration from
    AppContext.BaseDirectory therefore read the wrong file: RouteConfigurationTests threw
    KeyNotFoundException in its static initialiser (all ten cases), and the harness's gateway came
    up with NO attestation list and NO rate-limit policies, so 16 more cases in
    AttestationEnforcementTests and RateLimitTests asserted a 401 and got a 200. The suite has been
    failing 18 of 605 since C125 added the AppServices reference for Container7CoLocationTests.

    Copied after Build rather than declared as Content: a second Content item with the same target
    name is the same race in a different place, whereas this runs once everything else has been
    copied. Container7CoLocationTests reads Container7's static list and starts no host, so nothing
    in this project wants AppServices' settings.
  -->
  <Target Name="GatewaySettingsWinTheOutputDirectory" AfterTargets="Build">
    <Copy SourceFiles="..\ApiGateway\appsettings.json" DestinationFolder="$(OutDir)" />
  </Target>

</Project>
