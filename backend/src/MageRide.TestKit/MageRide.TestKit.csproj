<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MageRide.TestKit (C010) — the Testcontainers harness every service's integration tests
    build on. One definition of "a throwaway Postgres / Redis / Redpanda that matches the
    deployed stack", so a wave-2 service does not hand-roll its own and drift from
    infra/docker-compose.dev.slim.yml.

    This is a library, not a test project: it has no tests of its own and is never collected
    by `dotnet test`. Consumers reference it and use its fixtures.
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.TestKit</RootNamespace>
    <AssemblyName>MageRide.TestKit</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Explicitly NOT a test project: without this the SDK would look for a test runner. -->
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 for IAsyncLifetime and [CollectionDefinition]; the fixtures are xUnit
         collection fixtures, which is how a container is shared across a test class. -->
    <PackageReference Include="xunit.v3.extensibility.core" />
    <!-- C024: EMQX has no Testcontainers module, so EmqxFixture builds it from the generic
         ContainerBuilder in the base package. -->
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.Redpanda" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- C024: EmqxFixture bind-mounts the SAME broker policy infra/docker-compose.dev.slim.yml
         mounts, so a test asserts against the ACL that is actually deployed. Copied into the
         output rather than resolved by walking up to the repository root: a test's working
         directory depends on how it was launched, and a fixture that silently found nothing would
         start EMQX on its shipped defaults — which allow every topic, and would turn the ACL
         assertion green for the worst possible reason. Link keeps them in an `emqx/` folder so the
         two file names stay as they are on disk. -->
    <Content Include="..\..\..\infra\deploy\emqx\emqx.conf" Link="emqx\emqx.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\infra\deploy\emqx\acl.conf" Link="emqx\acl.conf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- The migration fixture applies the real db/migrations set through the same DbUp
         pipeline the `migrate` container uses (MageRide.Migrations.MigrationEngine), so a
         test database and a deployed database can never be migrated differently. The scripts
         travel as embedded resources in that assembly — no path resolution from a test. -->
    <ProjectReference Include="..\MageRide.Migrations\MageRide.Migrations.csproj" />
  </ItemGroup>

</Project>
