<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    C046 verify target: dotnet test backend/src/Wallet.Api.Tests -c Release

    Real Postgres, real Redis, real Redpanda. Every claim this component makes is a claim about
    something outside the process:

      * "every ledger entry balances to zero; the DB trigger rejects anything else" is
        `trg_balanced`, a DEFERRABLE INITIALLY DEFERRED constraint trigger that only a real server
        evaluates — and only at COMMIT;
      * "credits the wallet only once" for a replayed webhook is `ux_topups_provider_txn` and the
        UNIQUE on `billing.journal_entries.idempotency_key`, two indexes;
      * "no fee row is ever written" is the absence of a journal `kind` that could carry one, which
        means the assertion is a COUNT over real postings;
      * the D-08 write-through is a key dispatch-svc reads out of the same Redis;
      * `wallet.debited` / `wallet.credited` reach a broker through the kernel's LISTEN/NOTIFY
        outbox dispatcher, so the topic is asserted by consuming it.

    Microsoft.NET.Sdk.Web, not Microsoft.NET.Sdk: the harness builds a WebApplication.
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.Wallet.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!--
      xUnit1041: collection-fixture ctor args are consumed through the primary constructor.
      xUnit1051: every test is bounded by its own harness lifetime, so threading
                 TestContext.Current.CancellationToken through each call would add noise without
                 changing behaviour. Matches Dispatch/TripState/FleetHealth/Content.Tests.
    -->
    <NoWarn>$(NoWarn);xUnit1041;xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="StackExchange.Redis" />
    <!-- `wallet.events` is asserted by consuming it, so the outbox claim is made against the broker
         rather than against a table this service wrote. -->
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wallet.Api\Wallet.Api.csproj" />
    <!-- C010: the Postgres, Redis and Redpanda fixtures, so this suite runs the same server builds
         the dev stack does and applies the same migration set. -->
    <ProjectReference Include="..\MageRide.TestKit\MageRide.TestKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
