<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Provisioning.Api (C030, provisioning-svc) — the hardware tracker credential plane.

    Mints, binds, rotates and revokes per-device credentials: X.509 for MQTT-capable trackers
    that reach EMQX directly and a signed PSK for legacy TCP devices behind an adapter
    (ADD §7.7.3, T-02). Owns the IMEI ↔ vehicle binding that every inbound frame is resolved
    through (T-03), the anti-clone quarantine (T-08), bulk fleet onboarding (T-09) and the
    sub-second revocation signal both transports read (T-12).

    Protocol decoding is NOT here — that is tcp-adapter (C043). This service only mints, binds
    and revokes; the adapter calls GET /v1/internal/trackers/{imei}/validate and subscribes to
    the Redis channel this service publishes on.

    Verify: dotnet test backend/src/Provisioning.Api.Tests -c Release
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.Provisioning</RootNamespace>
    <AssemblyName>MageRide.Provisioning.Api</AssemblyName>
    <IsPackable>false</IsPackable>
    <UserSecretsId>mageride-provisioning-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MageRide.Shared\MageRide.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Provisioning.Api.Tests" />
  </ItemGroup>

</Project>
