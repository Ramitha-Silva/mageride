<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MageRide.Shared (C002) — the cross-cutting kernel every .NET service references.
    HTTP conventions, persistence infrastructure, messaging, auth, health. No domain rules,
    no endpoints, no EF Core (AL-53).
  -->

  <PropertyGroup>
    <RootNamespace>MageRide.Shared</RootNamespace>
    <AssemblyName>MageRide.Shared</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Middleware, minimal-API results, health checks and authorization come from the
         ASP.NET Core shared framework rather than packages. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Npgsql.NetTopologySuite" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="NetTopologySuite" />
    <!-- C024: the H3 grid moved up here when the fan-out plane (res 7) became the second caller
         beside the dispatch candidate index (res 5). See Geo/H3Grid.cs. -->
    <PackageReference Include="pocketken.H3" />
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Polly.Core" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MageRide.Shared.Tests" />
  </ItemGroup>

</Project>
